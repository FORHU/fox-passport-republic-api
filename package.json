{
  "name": "template-api-node",
  "version": "1.0.0",
  "main": "server.js",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm dlx kill-port 6002 && nodemon --watch src --ext ts --exec ts-node --files ./src/server.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "validate": "node tools/validate-architecture.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "prisma generate && tsc",
    "start": "node ./dist/src/server.js",
    "db:setup": "pnpm exec prisma generate && pnpm exec prisma migrate dev",
    "kill": "pnpm dlx kill-port 6002"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.998.0",
    "@aws-sdk/s3-request-presigner": "^3.998.0",
    "@faker-js/faker": "^9.9.0",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.2",
    "@types/pg": "^8.16.0",
    "@types/winston": "^2.4.4",
    "axios": "^1.6.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "express-validator": "^7.3.1",
    "google-auth-library": "^11.0.2",
    "handlebars": "^4.7.8",
    "helmet": "^7.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^3.0.2",
    "nodemailer": "^7.0.10",
    "openai": "^6.6.0",
    "pg": "^8.18.0",
    "redis": "^4.7.1",
    "resend": "^6.17.2",
    "socket.io": "^4.8.3",
    "stripe": "^18.0.0",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0",
    "winston": "^3.11.0"
  },
  "prisma": {
    "seed": "pnpm exec tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.18",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.33",
    "@types/node-cron": "^3.0.10",
    "@types/nodemailer": "^6.4.12",
    "@types/redis": "^4.0.11",
    "@types/supertest": "^2.0.14",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "nodemon": "^3.1.13",
    "prettier": "^3.0.3",
    "prisma": "^7.4.2",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
