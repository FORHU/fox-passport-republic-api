        "express": "^4.18.2",
        "express-rate-limit": "^7.1.0",
        "express-session": "^1.18.2",
        "express-validator": "^7.3.1",
        "handlebars": "^4.7.8",
        "helmet": "^7.0.0",
        "joi": "^17.11.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.0.2",
        "mysql2": "^3.16.0",
