<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="24px" font-family="Helvetica" color="#333333" font-weight="bold"> Space Deletion Request Notification </mj-text>
        <mj-divider border-color="#F45E43"></mj-divider>

        <mj-text font-size="18px" color="#333333" font-family="Helvetica"> Hello Admin, </mj-text>

        <mj-text font-size="16px" color="#555555" font-family="Helvetica">
          We wanted to inform you that a request has been made to delete the following venue:
        </mj-text>

        <mj-text font-size="16px" color="#555555" font-family="Helvetica">
          <strong>Venue Name:</strong> {space_name}<br />
          <strong>Location:</strong> {location}<br />
          <strong>Requested By:</strong> {owner_last_name}, {owner_first_name}<br />
          <strong>Request Date:</strong> {request_date}
        </mj-text>

        <mj-text font-size="16px" color="#555555" font-family="Helvetica">
          Please review this request and take the appropriate action. If this venue and it's associated spaces have active bookings or enquiries, it
          may not be eligible for deletion.
        </mj-text>

        <mj-text font-size="16px" color="#555555" font-family="Helvetica">
          Thank you,<br />
          Venue4Use
        </mj-text>

        <mj-divider border-color="#F45E43"></mj-divider>

        <mj-text font-size="14px" color="#999999" font-family="Helvetica">
          If you have any questions, feel free to contact support @support@venue4use.com
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
