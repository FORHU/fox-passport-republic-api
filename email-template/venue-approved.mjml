<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-divider border-color="#f45e43"></mj-divider>

        <mj-text font-size="20px" color="#f45e43" font-family="helvetica">Venue4Use: Venue Approval Notification</mj-text>

        <mj-text font-size="16px" color="#000000" font-family="helvetica">Dear {first_name},</mj-text>

        <mj-text font-size="16px" color="#000000" font-family="helvetica">
          We are pleased to inform you that the venue you submitted has been approved.
        </mj-text>

        <mj-text font-size="16px" color="#000000" font-family="helvetica">Here are the details of your venue:</mj-text>

        <mj-text font-size="16px" color="#000000" font-family="helvetica">
          <strong>Venue name:</strong> {venue_name} <br />
          <strong>Space name:</strong> {space_name} <br />
          <strong>Date submitted:</strong> {date_submitted} <br />
          <strong>Date approved:</strong> {date_approved}
        </mj-text>

        <mj-text font-size="16px" color="#000000" font-family="helvetica">
          Your venue is now live and available for bookings. Thank you for your efforts and cooperation.
        </mj-text>

        <mj-text font-size="16px" color="#000000" font-family="helvetica">
          If you have any questions, feel free to contact us at <a href="mailto:support@venue4use.com">support@venue4use.com</a>.
        </mj-text>

        <mj-text font-size="16px" color="#000000" font-family="helvetica">
          Best regards, <br />
          Venue4Use
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
