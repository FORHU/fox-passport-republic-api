<mjml>
  <mj-head>
    <mj-preview>Reminder: Complete Your Account Verification</mj-preview>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text align="center" font-size="24px" color="#333333" font-family="Arial, sans-serif" font-weight="bold">
          Complete Your Account Verification
        </mj-text>
        <mj-divider border-color="#F45E43"></mj-divider>
        <mj-text font-size="16px" color="#555555" font-family="Arial, sans-serif" align="center">
          Hi {first_name},<br /><br />
          We noticed you haven't fully verified your account yet. To complete your verification, please follow these steps:
        </mj-text>
        <mj-text font-size="16px" color="#555555" font-family="Arial, sans-serif">
          <ol>
            <li>Log in to your account.</li>
            <li>Click on your profile and choose <strong>settings</strong>.</li>
            <li>Select <strong>Account Settings</strong>.</li>
          </ol>
          Follow the on-screen instructions to confirm your email and set up your Stripe account for full verification.
        </mj-text>
        <mj-text font-size="14px" color="#888888" font-family="Arial, sans-serif" align="center">
          If you did not request this, you can safely ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#f4f4f4" padding="10px">
      <mj-column>
        <mj-text font-size="12px" color="#888888" font-family="Arial, sans-serif" align="center">
          &copy; 2025 Venue4Use. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
