<mjml>
  <mj-head>
    <mj-preview>Complete Your Account Verification</mj-preview>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text align="left" font-size="24px" color="#333333" font-family="Arial, sans-serif" font-weight="bold">
          Complete Your Account Verification
        </mj-text>
        <mj-divider border-color="#F45E43"></mj-divider>
        <mj-text font-size="16px" color="#555555" font-family="Arial, sans-serif" align="left"> Dear Venue Owner, </mj-text>
        <mj-text font-size="16px" color="#555555" font-family="Arial, sans-serif" align="left">
          We noticed that your account is not fully verified yet. To ensure your space is listed publicly, please verify the following:
        </mj-text>
        <mj-text font-size="16px" color="#555555" font-family="Arial, sans-serif" align="left"> {verification_message} </mj-text>
        <mj-text font-size="16px" color="#555555" font-family="Arial, sans-serif" align="left">
          To finish the verification process, follow these steps:
        </mj-text>
        <mj-text font-size="16px" color="#555555" font-family="Arial, sans-serif" align="left">
          <ol>
            <li>Log in to your account.</li>
            <li>Click on your profile and select <strong>Settings</strong>.</li>
            <li>Choose <strong>Account Settings</strong> and follow the on-screen instructions to complete the verification.</li>
          </ol>
        </mj-text>
        <mj-text font-size="16px" color="#F45E43" font-family="Arial, sans-serif" font-weight="bold" align="left">
          Please note that your venue will not be visible to the public until your account is fully verified.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#f4f4f4" padding="10px">
      <mj-column>
        <mj-text font-size="12px" color="#888888" font-family="Arial, sans-serif" align="left"> &copy; 2025 Venue4Use. All rights reserved. </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
