<mjml>
  <mj-head>
    <mj-title>Reset Your Password</mj-title>
    <mj-font name="Roboto" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700" />
    <mj-attributes>
      <mj-all font-family="Roboto, Helvetica, sans-serif" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f4f4f4">
    <!-- Header -->
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="24px" font-weight="bold" align="center" color="#333333"> Password Reset Request </mj-text>
      </mj-column>
    </mj-section>

    <!-- Content -->
    <mj-section background-color="#ffffff" padding="20px 20px">
      <mj-column>
        <mj-text font-size="16px" line-height="24px" color="#555555"> Hi there, </mj-text>

        <mj-text font-size="16px" line-height="24px" color="#555555"> We received a request to reset your password. Use the code below: </mj-text>

            </mj-section>

    <mj-section background-color="#4CAF50" border-radius="8px" padding="15px">
      <mj-column>
        <mj-text font-size="28px" font-weight="bold" align="center" color="#000000" letter-spacing="4px">
          {{OTP_CODE}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="20px 20px">
      <mj-column>

        <mj-text font-size="13px" line-height="20px" color="#999999" align="center" padding-top="10px"> This code will expire in 5 minutes </mj-text>

        <mj-divider border-color="#dddddd" padding="20px 0" />

        <mj-text font-size="14px" line-height="20px" color="#555555"> If you didn't request this password reset, please ignore this email. </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f4f4f4" padding="20px">
      <mj-column>
        <mj-text font-size="12px" color="#999999" align="center"> This is an automated message, please do not reply. </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
