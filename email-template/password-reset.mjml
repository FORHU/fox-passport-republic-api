<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <!-- Divider -->
        <mj-divider border-color="#F45E43"></mj-divider>

        <!-- Message -->
        <mj-text font-size="20px" color="#F45E43" font-family="helvetica">Venue4Use: Password Reset</mj-text>

        <!-- Greeting -->
        <mj-text font-size="16px" color="#000000" font-family="helvetica" padding-bottom="20px"> Dear [User's First Name], </mj-text>

        <!-- Password reset instructions -->
        <mj-text font-size="14px" color="#000000" font-family="helvetica" padding-bottom="20px">
          You recently requested to reset your password.<br />
          Please click the link to proceed: <br /><br />
          <a
            href="{verification_link}"
            style="
              display: inline-block;
              background: #4caf50;
              color: #ffffff;
              font-family: Ubuntu, Helvetica, Arial, sans-serif;
              font-size: 13px;
              font-weight: normal;
              line-height: 120%;
              margin: 0;
              text-decoration: none;
              text-transform: none;
              padding: 10px 25px;
              mso-padding-alt: 0px;
              border-radius: 3px;
            "
            target="_blank"
            >Confirm Your Email</a
          >
        </mj-text>

        <!-- Note -->
        <mj-text font-size="14px" color="#000000" font-family="helvetica" padding-bottom="20px">
          If you did not request a password reset, please ignore this email or reply to let us know.
        </mj-text>

        <!-- Farewell -->
        <mj-text font-size="14px" color="#000000" font-family="helvetica">
          Best regards,<br />
          The Venue4Use Team
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
