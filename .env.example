# Copy to `.env` and fill in. `.env*` is gitignored, so changes here are local
# only — anything you add must also reach teammates and deployed environments.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=6002
DATABASE_URL=postgresql://user:password@localhost:5432/foxpassportrepublic

# The Next.js client. CORS and the Stripe Connect return/refresh URLs derive
# from these.
CORS_ORIGIN=http://localhost:6001
FRONTEND_URL=http://localhost:6001

# --- Auth -------------------------------------------------------------------
# ACCESS_TOKEN_SECRET must be byte-identical to the app's ACCESS_TOKEN_SECRET:
# the Next proxy verifies access tokens that this API signed. If they differ,
# every protected route in the app redirects to `/`.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
SECRET_KEY=

# --- Pricing ----------------------------------------------------------------
PLATFORM_FEE_PERCENT=

# --- Redis (caching) --------------------------------------------------------
REDIS_HOST=localhost
# The port the API dials. With the bundled docker-compose this is the published
# host port, which defaults to 6378 (REDIS_HOST_PORT) to stay clear of a Redis
# already running on 6379.
REDIS_PORT=6378
REDIS_PASSWORD=
# The port docker-compose publishes Redis on. Keep it equal to REDIS_PORT when
# running the API outside compose; inside compose the API uses 6379 directly.
REDIS_HOST_PORT=6378

# --- AWS S3 (media uploads) -------------------------------------------------
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
CLOUD_FRONT_DOMAIN=
# Optional: point the S3 client at an S3-compatible service (e.g. local MinIO)
# instead of real AWS. Leave both unset to use real AWS.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=

# --- OpenAI -----------------------------------------------------------------
# Read by src/config/openai.config.ts, which nothing currently imports.
OPENAI_API_KEY=

# --- Mail -------------------------------------------------------------------
MAILER_EMAIL=
MAILER_PASSWORD=
MAILER_TRANSPORT_HOST=
MAILER_TRANSPORT_PORT=
MAILER_TRANSPORT_SECURE=
RESEND_API_KEY=

# --- Google OAuth -------------------------------------------------------------
# GOOGLE_CALLBACK_URL is only the *fallback* used when the OAuth2Client is
# constructed — every actual request builds its own redirect_uri from
# `${req.protocol}://${req.get("host")}/api/v1/auth/google/callback` (see
# resolveRedirectUri in auth.controller.ts), so sign-in works from whatever
# host the browser used to reach this API (localhost, a LAN IP for phone
# testing, a real domain), not just this one fixed value.
#
# Google still requires every redirect_uri it's ever asked to use to be
# pre-registered as an "Authorized redirect URI" in Cloud Console — add ONE
# per host you'll sign in from, e.g. for local dev + LAN phone testing:
#   http://localhost:6002/api/v1/auth/google/callback
#   http://192.168.1.34:6002/api/v1/auth/google/callback   (your LAN IP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:6002/api/v1/auth/google/callback
