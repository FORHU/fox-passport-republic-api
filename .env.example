# Copy to `.env` and fill in. `.env*` is gitignored, so changes here are local
# only — anything you add must also reach teammates and deployed environments.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=6002
DATABASE_URL=postgresql://user:password@localhost:5432/foxpassportrepublic

# The Next.js client. CORS and the Stripe Connect return/refresh URLs derive
# from these.
CORS_ORIGIN=http://localhost:6001
FRONTEND_URL=http://localhost:6001

# --- Auth (Better Auth) -----------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:6002

# --- Pricing ----------------------------------------------------------------
PLATFORM_FEE_PERCENT=

# --- Redis (caching) --------------------------------------------------------
REDIS_HOST=localhost
# The port the API dials. With the bundled docker-compose this is the published
# host port, which defaults to 6378 (REDIS_HOST_PORT) to stay clear of a Redis
# already running on 6379.
REDIS_PORT=6378
REDIS_PASSWORD=
# The port docker-compose publishes Redis on. Keep it equal to REDIS_PORT when
# running the API outside compose; inside compose the API uses 6379 directly.
REDIS_HOST_PORT=6378
# Managed Redis: set this instead of the three above. Use rediss:// for TLS.
# REDIS_URL=rediss://default:password@host:6380

# --- AWS S3 (media uploads) -------------------------------------------------
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
CLOUD_FRONT_DOMAIN=
# Private bucket for identity documents (IDs, clearances, proof of funds): no
# public access, no CloudFront. Read via short-lived presigned links only.
# With S3_ENDPOINT (local MinIO) it is created on first use if missing.
AWS_S3_PRIVATE_BUCKET=
# Optional: point the S3 client at an S3-compatible service (e.g. local MinIO)
# instead of real AWS. Leave both unset to use real AWS.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=

# --- AWS SQS (Asynchronous Message Queues - replaces RabbitMQ) ---------------
# Queue for payment events, invoice settlement, and asynchronous payout processing
AWS_SQS_PAYMENT_QUEUE_URL=
# Queue for decoupled notification, email dispatch, and booking reminders
AWS_SQS_NOTIFICATION_QUEUE_URL=
# Optional: point SQS client at LocalStack (e.g. http://localhost:4566)
SQS_ENDPOINT=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=

# --- OpenAI -----------------------------------------------------------------
# Read by src/config/openai.config.ts, which nothing currently imports.
OPENAI_API_KEY=

# --- Mail -------------------------------------------------------------------
# For real Gmail delivery, use a Gmail account with 2-Step Verification and a
# Google App Password. The Google OAuth client secret above is for sign-in and
# cannot authenticate SMTP mail.
#
# MAILER_EMAIL=your-gmail-address@gmail.com
# MAILER_PASSWORD=your-16-character-google-app-password
# MAILER_TRANSPORT_HOST=smtp.gmail.com
# MAILER_TRANSPORT_PORT=587
# MAILER_TRANSPORT_SECURE=false
#
# Alternatively, set RESEND_API_KEY and use the verified Resend sender in
# src/utils/mailer.ts. Ethereal is preview-only and never delivers to Gmail.
MAILER_EMAIL=
MAILER_PASSWORD=
MAILER_TRANSPORT_HOST=
MAILER_TRANSPORT_PORT=
MAILER_TRANSPORT_SECURE=
RESEND_API_KEY=

# --- Google OAuth (Better Auth) ----------------------------------------------
# Register <BETTER_AUTH_URL>/api/auth/callback/google as an Authorized
# redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
