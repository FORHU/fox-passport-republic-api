    Payment {
        string id PK
        string bookingId FK
        float amount
        string currency
        string method
        PaymentType paymentType
        PaymentStatus status
        string transactionId UK
        DateTime expiresAt
        DateTime paidAt
        DateTime createdAt
        DateTime updatedAt
    }

    Favorite {
        string id PK
        string userId FK
        string entityId
        string entityType
        DateTime createdAt
    }

    Review {
        string id PK
