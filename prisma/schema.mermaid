    Event {
        string id PK
        string clientId FK
        string organizerId FK
        string templateId FK
        string name
        string description
        EventCategory eventCategory
        DateTime startAt
        DateTime endAt
        int guestCount
        float totalAmount
        EventStatus eventStatus
        RequestStatus requestStatus
        string targetCity
        string targetState
        string targetCountry
        DateTime createdAt
        DateTime updatedAt
    }

