        DateTime updatedAt
    }

    EventTemplate {
        string id PK
        string ownerId FK
        string name
        string description
        EventCategory category
        boolean isPublic
        string targetCity
        string targetState
        string targetCountry
        DateTime createdAt
        DateTime updatedAt
    }

