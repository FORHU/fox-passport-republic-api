erDiagram
    User {
        string id PK
        string email UK
        string password
        string name
        string address
        string city
        string state
        string country
        string username UK
        string phone
        string imgId
        SystemRole systemRole
        RoleTypeArr roleType
        DateTime createdAt
        DateTime updatedAt
    }

    RoleRequest {
        string id PK
        string userId FK
        RoleType roleType
        RequestStatus status
        string reviewedBy FK
        DateTime reviewedAt
        string rejectionReason
        DateTime createdAt
        DateTime updatedAt
    }

    MayorApplication {
        string id PK
        string requestId FK, UK
        string businessName
        string contactNumber
        string address
        string tinNumber
        string description
        string validId1FileId FK
        string nbiFileId FK
        string tinIdFileId FK
        string birPermitFileId FK
        string selfieFileId FK
        DateTime createdAt
        DateTime updatedAt
    }

    FoxerAssetApplication {
