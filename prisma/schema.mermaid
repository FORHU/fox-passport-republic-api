        string location
        string validId1FileId FK
        string nbiFileId FK
        string tinIdFileId FK
        string birPermitFileId FK
        string selfieFileId FK
        string portfolioFileId FK
        DateTime createdAt
        DateTime updatedAt
    }

    File {
        string id PK
        string url
        string name
        string type
        string uploadedBy FK
        string venueId FK
        string assetId FK
        string serviceId FK
        string templateId FK
        DateTime createdAt
        DateTime updatedAt
        DateTime deletedAt
    }

    Passport {
        string id PK
        string userId FK, UK
        int totalStamps
        int totalMileage
        int level
        json achievements
        DateTime createdAt
        DateTime updatedAt
    }

    Asset {
        string id PK
