// Event templates, the events built from them, and their transactions.

model EventTemplate {
  id                   String                 @id @default(uuid())
  ownerId              String
  name                 String
  description          String
  category             EventCategory
  status               EventTemplateStatus    @default(draft)
  rejectionReason      String?
  isPublic             Boolean                @default(false)
  targetCity           String?
  targetState          String?
  targetCountry        String?                @default("Philippines")
  lat                  Float?
  lng                  Float?
  hostMarkupPct        Float                  @default(0)
  platformFeePct       Float                  @default(0.05) //might change later on
  maxAttendees         Int?
  publicOpenAt         DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  events               Event[]
  images               File[]
  owner                User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy?    @relation(fields: [cancellationPolicyId], references: [id])
  templateAssets       EventTemplateAsset[]
  templateServices     EventTemplateService[]
  templateVenues       EventTemplateVenue[]
  waitlist             Waitlist[]

  @@map("event_templates")
}

model EventTemplateAsset {
  id                 String             @id @default(uuid())
  templateId         String
  assetId            String?
  description        String?
  quantity           Int                @default(1)
  currency           String             @default("PHP")
  agreedPrice        Decimal            @default(0) @db.Decimal(12, 2)
  isOptional         Boolean            @default(false)
  date               DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  matched            Boolean            @default(false)
  matchedAt          DateTime?
  matchConstraint    MatchConstraint    @default(NONE)
  matchRequestStatus MatchRequestStatus @default(pending)
  asset              Asset?             @relation(fields: [assetId], references: [id])
  template           EventTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  eventAssetBids     EventAssetBid[]

  @@map("event_template_assets")
}

model EventTemplateService {
  id                 String             @id @default(uuid())
  templateId         String
  serviceId          String?
  description        String?
  currency           String             @default("PHP")
  agreedPrice        Decimal            @default(0) @db.Decimal(12, 2)
  isOptional         Boolean            @default(false)
  date               DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  matched            Boolean            @default(false)
  matchedAt          DateTime?
  matchConstraint    MatchConstraint    @default(NONE)
  matchRequestStatus MatchRequestStatus @default(pending)
  service            Service?           @relation(fields: [serviceId], references: [id])
  template           EventTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  eventServiceBids   EventServiceBid[]

  @@map("event_template_services")
}

model EventTemplateVenue {
  id                 String             @id @default(uuid())
  templateId         String
  venueId            String?
  description        String?
  currency           String             @default("PHP")
  agreedPrice        Decimal            @default(0) @db.Decimal(12, 2)
  isOptional         Boolean            @default(false)
  date               DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  matched            Boolean            @default(false)
  matchedAt          DateTime?
  matchConstraint    MatchConstraint    @default(NONE)
  matchRequestStatus MatchRequestStatus @default(pending)
  template           EventTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  venue              Venue?             @relation(fields: [venueId], references: [id])

  @@map("event_template_venues")
}

model Event {
  id                   String                     @id @default(uuid())
  clientId             String
  organizerId          String
  templateId           String?
  name                 String
  description          String
  eventCategory        EventCategory
  startAt              DateTime
  endAt                DateTime
  guestCount           Int
  totalAmount          Decimal                    @db.Decimal(12, 2)
  itemsTotal           Decimal                    @default(0) @db.Decimal(12, 2)
  hostMarkupAmount     Decimal                    @default(0) @db.Decimal(12, 2)
  platformFeeAmount    Decimal                    @default(0) @db.Decimal(12, 2)
  // Only ever set by the direct-venue-booking path (BookingSvc.createBooking's
  // `venueId && !eventId` branch). A template-based Event's discount lives
  // per line item instead — InvoiceItem.discountAmount, via
  // PricingSvc.resolveEventLineItemDiscounts — plus optionally one blanket
  // platform-wide discount at the aggregate Invoice level; neither is
  // mirrored onto this field.
  discountAmount       Decimal                    @default(0) @db.Decimal(12, 2)
  voucherId            String?
  voucherRedemption    VoucherRedemption?
  eventStatus          EventStatus                @default(pending)
  requestStatus        RequestStatus              @default(pending)
  rejectionReason      String?
  targetCity           String?
  targetState          String?
  targetCountry        String?                    @default("Philippines")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  bookings             Booking[]
  assetTransactions    EventAssetTransaction[]
  client               User                       @relation("EventClient", fields: [clientId], references: [id])
  host                 User                       @relation("EventOrganizer", fields: [organizerId], references: [id])
  template             EventTemplate?             @relation(fields: [templateId], references: [id])
  serviceTransactions  EventServiceTransaction[]
  venueTransactions    EventVenueTransaction[]
  posts                Post[]
  partnerInvestments   PartnerInvestment[]
  partnershipProposals PartnershipProposal[]
  appointments         Appointment[]
  // Whether approved Organizers may ask to join this Event's team. Off until
  // the Event Owner turns it on.
  acceptsOrganizerRequests Boolean @default(false)
  organizerXp          OrganizerEventXp[]
  inboxConversations   Conversation[]
  eventServiceBids     EventServiceBid[]
  eventAssetBids       EventAssetBid[]

  @@map("events")
}

model EventAssetTransaction {
  id                   String            @id @default(uuid())
  eventId              String
  bookingId            String?
  assetId              String
  providerId           String
  quantity             Int               @default(1)
  status               TransactionStatus @default(pending)
  agreedPrice          Decimal           @db.Decimal(12, 2)
  included             Boolean           @default(true)
  currency             String            @default("PHP")
  stripeTransferId     String?           @unique
  disputeReason        String?
  disputeAt            DateTime?
  lockedAt             DateTime?
  releasedAt           DateTime?
  // Ad-hoc marketplace items only (Design A); null for pre-attached items,
  // which never enter pending_provider_confirmation. Enforced by a DB CHECK
  // — see the Phase B marketplace migration.
  confirmationDeadline DateTime?
  rejectionReason      String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  asset                Asset             @relation(fields: [assetId], references: [id])
  event                Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  booking              Booking?          @relation(fields: [bookingId], references: [id])
  provider             User              @relation("AssetProvider", fields: [providerId], references: [id])

  @@map("event_asset_transactions")
}

model EventServiceTransaction {
  id                   String            @id @default(uuid())
  eventId              String
  bookingId            String?
  serviceId            String
  providerId           String
  status               TransactionStatus @default(pending)
  agreedPrice          Decimal           @db.Decimal(12, 2)
  included             Boolean           @default(true)
  currency             String            @default("PHP")
  stripeTransferId     String?           @unique
  disputeReason        String?
  disputeAt            DateTime?
  lockedAt             DateTime?
  releasedAt           DateTime?
  confirmationDeadline DateTime?
  rejectionReason      String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  event                Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  booking              Booking?          @relation(fields: [bookingId], references: [id])
  provider             User              @relation("ServiceProvider", fields: [providerId], references: [id])
  service              Service           @relation(fields: [serviceId], references: [id])

  @@map("event_service_transactions")
}

model EventVenueTransaction {
  id                   String            @id @default(uuid())
  eventId              String
  bookingId            String?
  venueId              String
  providerId           String
  status               TransactionStatus @default(pending)
  agreedPrice          Decimal           @db.Decimal(12, 2)
  included             Boolean           @default(true)
  currency             String            @default("PHP")
  stripeTransferId     String?           @unique
  disputeReason        String?
  disputeAt            DateTime?
  lockedAt             DateTime?
  releasedAt           DateTime?
  // Only ever set on a capacity-overage Request — the same fields
  // EventAssetTransaction/EventServiceTransaction already carry for their
  // pending_provider_confirmation lifecycle. Null for every ordinary venue
  // booking, which never enters that status.
  confirmationDeadline DateTime?
  rejectionReason      String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  event                Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  booking              Booking?          @relation(fields: [bookingId], references: [id])
  provider             User              @relation("VenueProvider", fields: [providerId], references: [id])
  venue                Venue             @relation(fields: [venueId], references: [id])

  @@map("event_venue_transactions")
}

enum MatchRequestStatus {
  pending
  accepted
  declined
  secured
}

enum MatchConstraint {
  SAME_STATE
  BROADER
  MANUAL_OVERRIDE
  NONE
}

enum EventStatus {
  draft
  pending
  ongoing
  completed
  cancelled
}

enum TransactionStatus {
  pending
  pending_provider_confirmation
  approved
  rejected
  cancelled
}

enum EventTemplateStatus {
  draft
  pending
  published
  rejected
  archived
}

enum EventCategory {
  corporate
  birthday
  wedding
  social
  other
}

model EventServiceBid {
  id                     String    @id @default(uuid())
  eventId                String
  eventTemplateServiceId String
  providerId             String // The Talent Foxer applying
  proposedServiceId      String // The specific Service listing the Foxer is offering
  message                String? // Cover letter/pitch
  proposedPrice          Decimal   @db.Decimal(12, 2)
  status                 BidStatus @default(pending)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  event             Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  provider          User                 @relation(fields: [providerId], references: [id])
  proposedService   Service              @relation(fields: [proposedServiceId], references: [id])
  targetRequirement EventTemplateService @relation(fields: [eventTemplateServiceId], references: [id])

  @@map("event_service_bids")
}

enum BidStatus {
  pending
  accepted
  rejected
  withdrawn
}

model EventAssetBid {
  id                   String    @id @default(uuid())
  eventId              String
  eventTemplateAssetId String
  providerId           String // The Gear Foxer applying
  proposedAssetId      String // The specific Asset listing the Foxer is offering
  message              String? // Cover letter/pitch
  proposedPrice        Decimal   @db.Decimal(12, 2)
  proposedQuantity     Int       @default(1)
  status               BidStatus @default(pending)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  provider          User               @relation(fields: [providerId], references: [id])
  proposedAsset     Asset              @relation(fields: [proposedAssetId], references: [id])
  targetRequirement EventTemplateAsset @relation(fields: [eventTemplateAssetId], references: [id])

  @@map("event_asset_bids")
}
