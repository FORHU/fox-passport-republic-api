// The category catalog: display data for the category values listings carry.
//
// The roots are `event` and `listing`; every other row is a subcategory of one
// of them. Provider specialties go one level deeper (api#503): a main category
// (`isGroup`, such as Photo & Video) under `listing`, with its subcategories
// (Photography, Videography) under it. Nothing is deeper. `slug` is the key that links a row to the
// values stored on `Asset.category`, `Venue.category`, `Service.category` and
// `EventTemplate.category`, so it never changes after creation. Listings still
// validate their category against the enums in common.prisma, catalog.prisma
// and event.prisma; this table does not replace those yet.
model Category {
  id                   String                        @id @default(uuid())
  slug                 String                        @unique
  name                 String
  description          String?
  icon                 String?
  /// A Provider main category under listing; its children are the specialties.
  isGroup              Boolean                       @default(false)
  /// No longer offered for new picks; still valid for Providers who hold it.
  retiredAt            DateTime?
  parentCategoryId     String?
  parent               Category?                     @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  children             Category[]                    @relation("CategoryTree")
  specialtySuggestions ProviderSpecialtySuggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentCategoryId])
  @@map("categories")
}

enum ProviderSpecialtySuggestionStatus {
  pending
  approved
  rejected
}

// A specialty a Provider applicant asked for that the catalog lacks (api#440).
// It is never a valid specialty itself: only approval, by someone with
// `categories:manage`, creates the catalog row (`categoryId`) that the apply
// form and the specialty checks read.
model ProviderSpecialtySuggestion {
  id            String                            @id @default(uuid())
  name          String
  slug          String
  status        ProviderSpecialtySuggestionStatus @default(pending)
  suggestedById String
  suggestedBy   User                              @relation("SpecialtySuggester", fields: [suggestedById], references: [id], onDelete: Cascade)
  reviewedById  String?
  reviewedBy    User?                             @relation("SpecialtyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  categoryId    String?
  category      Category?                         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([slug])
  @@index([suggestedById])
  @@map("provider_specialty_suggestions")
}
