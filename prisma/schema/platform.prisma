// Cross-cutting platform concerns owned by no single domain.

model File {
  id                      String                    @id @default(uuid())
  url                     String
  name                    String
  type                    String
  uploadedBy              String?
  venueId                 String?
  assetId                 String?
  serviceId               String?
  templateId              String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  asset                   Asset?                    @relation(fields: [assetId], references: [id])
  service                 Service?                  @relation(fields: [serviceId], references: [id])
  template                EventTemplate?            @relation(fields: [templateId], references: [id])
  user                    User?                     @relation(fields: [uploadedBy], references: [id])
  venue                   Venue?                    @relation(fields: [venueId], references: [id])
  gearFoxerBirPermit      GearFoxerApplication[]    @relation("GearFoxerBirPermit")
  gearFoxerNbi            GearFoxerApplication[]    @relation("GearFoxerNBI")
  gearFoxerSelfie         GearFoxerApplication[]    @relation("GearFoxerSelfie")
  gearFoxerTinId          GearFoxerApplication[]    @relation("GearFoxerTinId")
  gearFoxerValidId1       GearFoxerApplication[]    @relation("GearFoxerValidId1")
  serviceFoxerBirPermit   ServiceFoxerApplication[] @relation("ServiceFoxerBirPermit")
  serviceFoxerNbi         ServiceFoxerApplication[] @relation("ServiceFoxerNBI")
  serviceFoxerSelfie      ServiceFoxerApplication[] @relation("ServiceFoxerSelfie")
  serviceFoxerTinId       ServiceFoxerApplication[] @relation("ServiceFoxerTinId")
  serviceFoxerValidId1    ServiceFoxerApplication[] @relation("ServiceFoxerValidId1")
  eventFoxerBirPermit     EventFoxerApplication[]   @relation("EventFoxerBirPermit")
  eventFoxerNbi           EventFoxerApplication[]   @relation("EventFoxerNBI")
  eventFoxerPortfolio     EventFoxerApplication[]   @relation("EventFoxerPortfolio")
  eventFoxerSelfie        EventFoxerApplication[]   @relation("EventFoxerSelfie")
  eventFoxerTinId         EventFoxerApplication[]   @relation("EventFoxerTinId")
  eventFoxerValidId1      EventFoxerApplication[]   @relation("EventFoxerValidId1")
  investorProof           InvestorApplication[]     @relation("InvestorProof")
  venueFoxerBirPermit     VenueFoxerApplication[]   @relation("VenueFoxerBirPermit")
  venueFoxerNbi           VenueFoxerApplication[]   @relation("VenueFoxerNBI")
  venueFoxerSelfie        VenueFoxerApplication[]   @relation("VenueFoxerSelfie")
  venueFoxerTinId         VenueFoxerApplication[]   @relation("VenueFoxerTinId")
  venueFoxerValidId1      VenueFoxerApplication[]   @relation("VenueFoxerValidId1")
  eventFoxerPortfolioMany EventFoxerApplication[]   @relation("EventFoxerPortfolioMany")

  @@map("files")
}

/// A record of a security-sensitive change, kept because "who gave this person
/// admin?" is a question with no answer otherwise.
///
/// Refusals are recorded as well as successes: a log of what worked shows the
/// changes, but only a log of what was *attempted* shows an escalation attempt.
model AuditLog {
  id          String   @id @default(uuid())
  /// Who acted. Not a relation to `User` on purpose - the record must survive
  /// the actor's account being deleted, which is exactly when it matters most.
  actorId     String
  actorEmail  String
  /// What was acted on, and of what kind. `action` is a verb the reader can
  /// scan: "systemRole.change", "roleType.change".
  action      String
  targetId    String
  targetEmail String?
  /// Whatever the action needs to be understood later - previous and new role,
  /// the reason a refusal was refused. JSON so a new action does not need a
  /// migration to say something new.
  metadata    Json?
  /// "allowed" or "refused". Stored rather than inferred, so a query for
  /// refusals does not depend on interpreting the metadata.
  outcome     String
  createdAt   DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
