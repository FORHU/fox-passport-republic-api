// Reward rules, immutable ledger, and lifecycle records for XP and Coins.

enum RewardLifecycleType {
  RELEASE
  REDEMPTION
  EXPIRY // unused: Tokens never expire (rewards spec, 2026-11-11)
  REVERSAL
  VOUCHER_RETURN // Tokens returned for a Token voucher that expired unused
}

model RewardRule {
  id        String   @id @default(uuid())
  action    String   @unique
  xp        Int      @default(0)
  coins     Int      @default(0)
  dailyCap  Int?
  onceOnly  Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reward_rules")
}

model RewardEvent {
  id             String            @id @default(uuid())
  userId         String
  path           UserPath
  action         String
  refType        String
  refId          String
  xp             Int               @default(0)
  coins          Int               @default(0)
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifecycles     RewardLifecycle[]

  @@index([userId, createdAt])
  @@index([refType, refId])
  @@index([userId, path])
  @@index([action, createdAt])
  @@map("reward_events")
}

model RewardLifecycle {
  id           String              @id @default(uuid())
  grantEventId String
  userId       String
  type         RewardLifecycleType
  coinsDelta   Int
  reversalOf   String?
  reason       String?
  createdAt    DateTime            @default(now())

  grantEvent   RewardEvent         @relation(fields: [grantEventId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([grantEventId])
  @@index([userId, type])
  @@index([reversalOf])
  @@map("reward_lifecycles")
}

model UserOnboarding {
  id          String   @id @default(uuid())
  userId      String
  step        String
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, step])
  @@map("user_onboardings")
}

model CoinReward {
  id                 String           @id @default(uuid())
  title              String
  description        String?
  targetAudience     String           @default("citizen") // "citizen", "foxer", "all"
  coinCost           Int
  rewardType         String           // "booking_voucher", "fee_discount", "listing_boost"
  discountPhp        Decimal?         @db.Decimal(12, 2)
  discountPercentage Decimal?         @db.Decimal(5, 2)
  minLevel           Int              @default(1)
  active             Boolean          @default(true)
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  redemptions        CoinRedemption[]

  @@map("coin_rewards")
}

model CoinRedemption {
  id         String     @id @default(uuid())
  userId     String
  rewardId   String
  coinsSpent Int
  voucherId  String?    @unique
  status     String     @default("completed") // "completed", "cancelled", "returned" (expired unused, Tokens returned)
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward     CoinReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  voucher    Voucher?   @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("coin_redemptions")
}


// What a milestone counts. Admin-editable rows, so a change needs no deploy.
enum MilestoneCounter {
  booked_events
  attended_events
  cities
  venues
  reviews
  spend // pesos paid on attended bookings, net of refunds (Big Spender)
}

// Whether a booking counts once payment is confirmed or only once attended.
enum MilestoneCountMode {
  paid
  attended
}

enum ChallengeWindow {
  day
  week
  month // all three in Manila time
}

// A cumulative milestone: every tier pays its Tokens once as the count grows.
model Milestone {
  id          String             @id @default(uuid())
  key         String             @unique
  name        String
  description String?
  counter     MilestoneCounter
  counts      MilestoneCountMode @default(attended)
  active      Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tiers       MilestoneTier[]

  @@map("milestones")
}

model MilestoneTier {
  id          String    @id @default(uuid())
  milestoneId String
  tier        Int
  target      Int // a count, or whole pesos for the spend counter
  tokens      Int       @default(0)
  badgeName   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, tier])
  @@map("milestone_tiers")
}

// A booking challenge over a day, week or month in Manila time.
model Challenge {
  id          String          @id @default(uuid())
  key         String          @unique
  name        String
  description String?
  period      ChallengeWindow
  target      Int
  tokens      Int             @default(0)
  active      Boolean         @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("challenges")
}
