// Republic Foxer community feed, comments, and interactions

enum PostType {
  citizen_experience
  review_share
  venue_spotlight
  gear_offering
  service_offering
  event_announcement
  partner_announcement
  poll
}

enum FeedTab {
  community
  marketplace
  partners
}

enum PostVisibility {
  public
  followers
  only_me
}

enum ReactionType {
  like
  love
  haha
  wow
  sad
  angry
}

enum ReportTargetType {
  post
  user
  venue
}

model Post {
  id         String         @id @default(uuid())
  authorId   String
  type       PostType
  tab        FeedTab
  content    String         @db.Text
  mediaUrls  String[]       @default([])
  visibility PostVisibility @default(public)

  // Optional foreign keys to existing entities (validated based on type)
  venueId   String?
  assetId   String?
  serviceId String?
  eventId   String?
  reviewId  String?
  stampId   String?

  // Counters for performant indexing & sorting
  likesCount    Int @default(0)
  commentsCount Int @default(0)
  sharesCount   Int @default(0)

  isPinned   Boolean   @default(false)
  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  // Set once a post has been edited — null means never edited.
  editedAt   DateTime?

  // A repost is its own independent Post row, not a pointer-only wrapper —
  // this just points back at the post it was reposted from (SetNull so
  // deleting the original doesn't take the repost down with it).
  originalPostId String?

  // Relations
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  venue        Venue?         @relation(fields: [venueId], references: [id], onDelete: SetNull)
  asset        Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  service      Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  event        Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  review       Review?        @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  stamp        PassportStamp? @relation(fields: [stampId], references: [id], onDelete: SetNull)
  originalPost Post?          @relation("PostRepost", fields: [originalPostId], references: [id], onDelete: SetNull)
  reposts      Post[]         @relation("PostRepost")

  comments  PostComment[]
  likes     PostLike[]
  savedBy   SavedPost[]
  hiddenFor HiddenPost[]
  messages  Message[]
  mediaTags PostMediaTag[]
  poll      Poll?

  @@index([tab, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([type])
  @@map("feed_posts")
}

// One-to-one with a `type: poll` Post — the poll's question is just that
// post's `content` (same as how venue_spotlight etc. use content as the
// caption alongside their own linked entity), so this only models the
// options and votes. Single-choice only for now, not Facebook's
// multi-select — a user's existing vote is replaced rather than stacked.
model Poll {
  id        String   @id @default(uuid())
  postId    String   @unique
  createdAt DateTime @default(now())

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options PollOption[]

  @@map("feed_polls")
}

model PollOption {
  id         String @id @default(uuid())
  pollId     String
  label      String
  position   Int    @default(0)
  // Denormalized counter, same pattern as PostComment.likesCount — avoids a
  // COUNT(*) over votes on every poll render.
  votesCount Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("feed_poll_options")
}

model PollVote {
  pollOptionId String
  userId       String
  createdAt    DateTime @default(now())

  option PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollOptionId, userId])
  @@map("feed_poll_votes")
}

// Pins a citizen to an (x, y) spot on one photo/video within a post's
// mediaUrls — distinct from an @mention in the post text (see
// MENTION_PATTERN in feed.service.ts). x/y are 0-100 percentages from the
// media's top-left corner, resolution-independent.
model PostMediaTag {
  id        String   @id @default(uuid())
  postId    String
  mediaUrl  String
  userId    String
  x         Float
  y         Float
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@map("feed_post_media_tags")
}

model PostComment {
  id         String   @id @default(uuid())
  postId     String
  authorId   String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // One level of replies only, Facebook/Messenger-style — a reply's own
  // parentId is always a top-level comment's id, never another reply's.
  parentId   String?
  likesCount Int      @default(0)

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("CommentReplies")
  likes   CommentLike[]

  @@index([postId, createdAt(sort: Asc)])
  @@index([parentId])
  @@map("feed_post_comments")
}

model PostLike {
  postId    String
  userId    String
  // One reaction per user per post — re-reacting with a different emoji
  // replaces it (upsert on the composite key) rather than stacking.
  type      ReactionType @default(like)
  createdAt DateTime     @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("feed_post_likes")
}

model CommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@map("feed_post_comment_likes")
}

model SavedPost {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("feed_saved_posts")
}

model HiddenPost {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("feed_hidden_posts")
}

// Polymorphic — targetId points at either a Post or a User depending on
// targetType, so it deliberately has no foreign key of its own (only
// reporterId does); the target isn't guaranteed to still exist.
model Report {
  id         String           @id @default(uuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  details    String?
  createdAt  DateTime         @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@map("reports")
}
