// Payments, payouts, refunds and the policies that govern them.

model Payment {
  id                String        @id @default(uuid())
  bookingId         String
  amount            Decimal       @db.Decimal(12, 2)
  currency          String
  method            String
  paymentType       PaymentType
  status            PaymentStatus
  transactionId     String?       @unique
  expiresAt         DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  hostMarkupAmount  Decimal       @default(0) @db.Decimal(12, 2)
  platformFeeAmount Decimal       @default(0) @db.Decimal(12, 2)
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  @@map("payments")
}

model Payout {
  id               String       @id @default(uuid())
  recipientId      String
  role             RoleType
  sourceType       String // "assetBooking" | "serviceBooking" | "booking"
  sourceId         String
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @default("PHP")
  stripeTransferId String?
  status           PayoutStatus @default(pending)
  failureReason    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  recipient        User         @relation(fields: [recipientId], references: [id])

  @@unique([sourceType, sourceId, recipientId, role])
  @@index([sourceType, sourceId])
  @@index([recipientId])
  @@map("payouts")
}

model Refund {
  id             String       @id @default(uuid())
  bookingId      String
  paymentId      String?
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("PHP")
  stripeRefundId String?      @unique
  status         RefundStatus @default(pending)
  failureReason  String?
  failureCode    String?
  initiatedBy    String?
  resolved       Boolean      @default(false)
  resolvedBy     String?
  resolvedAt     DateTime?
  adminNotes     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment        Payment?     @relation(fields: [paymentId], references: [id])

  @@index([bookingId])
  @@index([status])
  @@map("refunds")
}

model CancellationPolicy {
  id          String             @id @default(uuid())
  name        String //"Flexible", "Moderate", "Strict"
  asset       Asset[]
  venue       Venue[]
  service     Service[]
  templates   EventTemplate[]
  description String?
  isActive    Boolean            @default(true)
  rules       CancellationRule[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("cancellation_policies")
}

model CancellationRule {
  id               String             @id @default(uuid())
  policyId         String
  hoursBeforeEvent Int
  refundPercent    Int
  policy           CancellationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@map("cancellation_rules")
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@map("stripe_events")
}

enum RefundStatus {
  pending
  succeeded
  failed
}

enum PayoutStatus {
  pending
  paid
  failed
}

enum PaymentType {
  deposit
  full
}
