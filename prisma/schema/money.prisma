// Payments, payouts, refunds and the policies that govern them.

enum InvoiceStatus {
  pending
  processing
  paid
  failed
  cancelled
  refunded
  partially_refunded
}

enum InvoiceSourceType {
  booking
  event_asset_transaction
  event_service_transaction
  event_venue_transaction
  sponsorship
}

enum CheckoutStatus {
  active
  completed
  expired
  failed
}

enum RefundStatus {
  pending
  succeeded
  failed
}

enum PayoutStatus {
  pending
  paid
  failed
}

enum PayoutSourceType {
  event_asset_transaction
  event_service_transaction
  event_venue_transaction
  event_host_markup
  sponsorship
  investor_revenue_share
}

model PlatformFeeConfig {
  id   String @id @default(uuid())
  name String

  transactionType String?
  category        String?
  subcategory     String?

  percentage  Decimal? @db.Decimal(5, 2)
  fixedAmount Decimal? @db.Decimal(12, 2)
  currency    String   @default("PHP")

  priority Int     @default(0)
  active   Boolean @default(true)

  effectiveFrom  DateTime  @default(now())
  effectiveUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionType])
  @@index([category])
  @@index([active])
  @@map("platform_fee_configs")
}

// --- PROMOTIONS & VOUCHERS ---

model Promotion {
  id          String  @id @default(uuid())
  name        String
  description String?

  transactionType String?
  category        String?
  subcategory     String?

  // Null on all four: an admin-created, platform-wide promotion (its
  // discount is absorbed by the platform — see PayoutSvc). Non-null
  // providerId with exactly one of assetId/serviceId/venueId set: a Foxer's
  // own promo on their own listing, funded out of that Foxer's own payout
  // rather than the platform's. Enforced in PromotionSvc, not the schema.
  // Matches a *direct* asset/service/venue booking (see Event.voucherId's
  // comment) AND a matching line item inside a multi-provider Event
  // checkout (see PricingSvc.resolveEventLineItemDiscounts /
  // InvoiceItem.discountAmount) — the same code works either way a citizen
  // buys that exact listing.
  providerId String?
  assetId    String?
  serviceId  String?
  venueId    String?

  discountType  String // "percentage" or "fixed"
  discountValue Decimal  @db.Decimal(12, 2)
  minSubtotal   Decimal? @db.Decimal(12, 2)
  maxDiscount   Decimal? @db.Decimal(12, 2)

  active    Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?

  // When true, this promotion applies automatically at checkout to anyone
  // whose purchase matches its scope — no code to type. Still redeemed
  // through the ordinary Voucher/VoucherRedemption machinery: turning this
  // on gets the promotion exactly one system-generated, never-shown Voucher
  // (see PromotionSvc.ensureAutoApplyVoucher), so usageLimit/perUserLimit
  // are enforced identically to a code-based promotion.
  autoApply Boolean @default(false)

  usageLimit   Int?
  perUserLimit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vouchers Voucher[]
  provider User?     @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@map("promotions")
}

model Voucher {
  id          String @id @default(uuid())
  code        String @unique
  promotionId String

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  promotion    Promotion           @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  redemptions  VoucherRedemption[]
  invoiceItems InvoiceItem[]

  @@map("vouchers")
}

model VoucherRedemption {
  id             String  @id @default(uuid())
  voucherId      String
  userId         String
  discountAmount Decimal @db.Decimal(12, 2)

  // Nullable: an Asset/Service booking has no Invoice row (it settles
  // through its own `paymentTransactionId`, not the generic Payment/Invoice
  // model) — same generalization as `Refund` above. Exactly one of
  // invoiceId/invoiceItemId/assetBookingId/serviceBookingId/eventId is set
  // on any given row.
  //
  // `invoiceId` alone (no `invoiceItemId`) is a *blanket* platform-wide
  // discount against the whole invoice — the pre-existing single-code
  // behavior. `invoiceItemId` set is a Foxer-owned discount scoped to one
  // line item inside a multi-provider Event checkout (see PricingSvc.
  // resolveEventLineItemDiscounts) — an Invoice can carry one blanket
  // redemption *and* one per-item redemption per item, which is why
  // `invoiceId` is no longer `@unique`; `invoiceItemId` still is, since a
  // given item can only ever be discounted once.
  invoiceId        String?
  invoiceItemId    String? @unique
  assetBookingId   String? @unique
  serviceBookingId String? @unique
  // A direct venue booking's redemption — see Event.voucherId's comment.
  // Never set for a template-based Event (those redeem through
  // invoiceId/invoiceItemId).
  eventId          String? @unique

  redeemedAt DateTime @default(now())

  voucher        Voucher         @relation(fields: [voucherId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id])
  invoiceItem    InvoiceItem?    @relation(fields: [invoiceItemId], references: [id])
  assetBooking   AssetBooking?   @relation(fields: [assetBookingId], references: [id])
  serviceBooking ServiceBooking? @relation(fields: [serviceBookingId], references: [id])
  event          Event?          @relation(fields: [eventId], references: [id])

  @@map("voucher_redemptions")
}

model Invoice {
  id             String  @id @default(uuid())
  payerId        String
  subtotalAmount Decimal @db.Decimal(12, 2) // Sum of items

  discountAmount   Decimal @default(0) @db.Decimal(12, 2)
  discountSnapshot Json?

  discountedSubtotal Decimal @default(0) @db.Decimal(12, 2)

  platformFeeAmount   Decimal @default(0) @db.Decimal(12, 2) // Snapshotted fee
  platformFeeSnapshot Json? // Snapshot of PlatformFeeConfig

  grossAmount Decimal       @db.Decimal(12, 2) // discountedSubtotal + fee
  currency    String        @default("PHP")
  status      InvoiceStatus @default(pending)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payer       User                @relation(fields: [payerId], references: [id])
  items       InvoiceItem[]
  checkouts   Checkout[]
  payments    Payment[]
  redemptions VoucherRedemption[]

  @@map("invoices")
}

model InvoiceItem {
  id          String            @id @default(uuid())
  invoiceId   String
  amount      Decimal           @db.Decimal(12, 2)
  description String
  sourceType  InvoiceSourceType
  sourceId    String

  // Per-item discount for a multi-provider Event checkout — see
  // PricingSvc.resolveEventLineItemDiscounts and
  // PaymentPayoutSvc.allocatePayouts. Zero/null on every item this never
  // applies to (single-item invoices like a sponsorship, or an Event item
  // nobody discounted). `voucherId` names which code did it, purely so the
  // payout webhook doesn't have to join back through VoucherRedemption to
  // find out — the actual redemption bookkeeping still lives there.
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  voucherId      String?

  invoice    Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  voucher    Voucher?           @relation(fields: [voucherId], references: [id])
  redemption VoucherRedemption?
  refunds    Refund[]

  @@map("invoice_items")
}

model Checkout {
  id                String         @id @default(uuid())
  invoiceId         String
  provider          String // e.g., "stripe"
  providerSessionId String?        @unique // e.g., Stripe Checkout Session ID
  status            CheckoutStatus @default(active)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("checkouts")
}

model Payment {
  id                String        @id @default(uuid())
  invoiceId         String?
  assetBookingId    String?
  serviceBookingId  String?
  amount            Decimal       @db.Decimal(12, 2)
  method            String
  provider          String        @default("stripe")
  providerReference String?       @unique
  status            PaymentStatus @default(pending)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  invoice         Invoice?         @relation(fields: [invoiceId], references: [id])
  assetBooking    AssetBooking?    @relation(fields: [assetBookingId], references: [id])
  serviceBooking  ServiceBooking?  @relation(fields: [serviceBookingId], references: [id])
  refunds         Refund[]

  @@index([assetBookingId])
  @@index([serviceBookingId])

  @@map("payments")
}

model Payout {
  id                String           @id @default(uuid())
  providerId        String
  sourceType        PayoutSourceType
  sourceId          String
  allocationAmount  Decimal          @db.Decimal(12, 2)
  platformFeeAmount Decimal          @default(0) @db.Decimal(12, 2)
  gatewayFeeAmount  Decimal          @default(0) @db.Decimal(12, 2)
  payoutAmount      Decimal          @db.Decimal(12, 2) // allocation - fees
  status            PayoutStatus     @default(pending)
  providerReference String? // e.g., Stripe Transfer ID
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  providerUser User @relation(fields: [providerId], references: [id])

  // Idempotency guard: a retried webhook or a defensively-repeated
  // updateStatus(completed) must not create a second Payout (and fire a
  // second Stripe transfer) for the same provider's cut of the same source
  // row. `PayoutSvc.createPayoutRecord` upserts against this.
  @@unique([sourceType, sourceId, providerId])
  @@map("payouts")
}

model Refund {
  id                String       @id @default(uuid())
  // Nullable: an Asset/Service booking refund settles against that booking's
  // own `stripePaymentId` field directly, not a generic Payment row — see
  // assetBookingId/serviceBookingId below. Exactly one of paymentId/
  // assetBookingId/serviceBookingId is set on any given row.
  paymentId         String?
  amount            Decimal      @db.Decimal(12, 2)
  reason            String?
  providerReference String?      @unique
  status            RefundStatus @default(pending)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  payment   Payment? @relation(fields: [paymentId], references: [id])
  booking   Booking? @relation(fields: [bookingId], references: [id])
  bookingId String?

  assetBooking     AssetBooking?   @relation(fields: [assetBookingId], references: [id])
  assetBookingId   String?
  serviceBooking   ServiceBooking? @relation(fields: [serviceBookingId], references: [id])
  serviceBookingId String?

  // A multi-provider Event checkout's per-item refund (see
  // EventCheckoutSvc.cancelEvent) — `paymentId` still names the one shared
  // Stripe PaymentIntent (all providers on one Event share a single
  // payment), this just says which line item this particular refund
  // covers. Null for every other refund kind above.
  invoiceItem   InvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  invoiceItemId String?

  // Manual/admin-reviewed itemized refunds only (Phase B marketplace scope).
  // A refund with either of these set is scoped to one line item, not the
  // whole booking; whole-booking refunds via the existing automated path
  // leave both null. Deliberately plain scalars (no Prisma relation object)
  // to avoid widening the Asset/Service-transaction models' back-relations
  // for what is an admin-tooling concern — FK constraints are still enforced
  // at the database level in the migration.
  assetTransactionId   String?
  serviceTransactionId String?
  initiatedByAdminId   String?

  @@map("refunds")
}

model PaymentProviderEvent {
  id              String    @id @default(uuid())
  provider        String // "stripe"
  providerEventId String
  eventType       String // e.g., "payment_intent.succeeded"
  payload         Json
  processed       Boolean   @default(false)
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@map("payment_provider_events")
}

model CancellationPolicy {
  id          String             @id @default(uuid())
  name        String //"Flexible", "Moderate", "Strict"
  asset       Asset[]
  venue       Venue[]
  service     Service[]
  templates   EventTemplate[]
  description String?
  isActive    Boolean            @default(true)
  rules       CancellationRule[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("cancellation_policies")
}

model CancellationRule {
  id               String             @id @default(uuid())
  policyId         String
  hoursBeforeEvent Int
  refundPercent    Int
  policy           CancellationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@map("cancellation_rules")
}
