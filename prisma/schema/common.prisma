// Enums shared by more than one domain.

enum AssetCategory {
  furnitures
  sound_system
  decorations
  equipment
  other
  // The catalog subcategories that are rented out (api#503 follow-up).
  lighting
  led_screens
  stage_truss
  special_effects
  tents
  linens_tableware
  generators_power
  backdrops_props
  gowns_suits
}

enum VenueCategory {
  indoor
  outdoor
  hotel
  beach_resort
  garden
  mix
  other
}

enum ComponentType {
  asset
  service
  venue
}

enum RoleType {
  venueFoxer
  eventFoxer
  investor
  organizer
  providerFoxer
}

enum RequestStatus {
  pending
  approved
  rejected
  // Distinct from rejected: specific documents were flagged (see
  // RoleRequest.flaggedDocuments/revisionNote) and the applicant can fix
  // just those instead of resubmitting the whole application.
  revision_requested
  // The applicant took back their own open (pending or revision_requested)
  // role application before an admin decided it (api#367). Kept on record;
  // they can apply for the role again.
  withdrawn
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  cancelled
  refunded
  partially_refunded
}
