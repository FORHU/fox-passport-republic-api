generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////
// ENUMS
//////////////////////////////////////

enum UserRole {
  user
  host
  foxxer
  admin
  super_admin
}

enum ListingStatus {
  draft
  pending_review
  action_required
  published
  hidden
  suspended
  archived
  banned
}

enum ListingType {
  venue
  equipment
  catering
  service
  event
}

enum PropertyType {
  hotel
  resort
  hall
  outdoor
  studio
  land
  private_home
  other
}

enum RoomType {
  entire_place
  private_room
  shared_room
}

enum BookingStatus {
  draft
  pending
  confirmed
  cancelled
  completed
}

enum BookingType {
  standard
  foxxer_service
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PaymentMethod {
  card
  gcash
  paymaya
  bank_transfer
  cash
  other
}

enum CancellationPolicy {
  flexible
  moderate
  strict
  non_refundable
}

enum Attendee CheckInStatus {
  not_checked_in
  checked_in
}

/* ✅ NEW WEDDING ENUMS (SAFE) */

enum WeddingCategory {
  wedding
}

enum WeddingVenueSubCategory {
  church_wedding
  civil_wedding
  garden_wedding
  beach_wedding
  destination_wedding
  indoor_venue
  outdoor_venue
  reception_hall
  intimate_micro_wedding
}

//////////////////////////////////////
// MODELS
//////////////////////////////////////

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  name         String
  username     String    @unique
  phone        String?
  profileImage String?
  dateOfBirth  DateTime?
  role         UserRole  @default(user)
  isFoxxer     Boolean   @default(false)
  isHost       Boolean   @default(false)
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  listings      Listing[]      @relation("HostListings")
  foxxerProfile FoxxerProfile?
  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@map("users")
}

model FoxxerProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  bio          String?
  skills       String?
  rating       Decimal? @default(0)
  totalReviews Int      @default(0)
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  services ListingFoxxerService[]

  @@map("foxxer_profiles")
}

model EventCategory {
  id      String  @id @default(uuid())
  name    String
  slug    String  @unique
  iconUrl String?

  foxxerServices ListingFoxxerService[]

  @@map("event_categories")
}

model ListingFoxxerService {
  id                 String   @id @default(uuid())
  foxxerId           String
  listingId          String
  categoryId         String
  serviceName        String
  serviceDescription String?
  price              Decimal
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  foxxer   FoxxerProfile @relation(fields: [foxxerId], references: [id], onDelete: Cascade)
  listing  Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([foxxerId])
  @@index([listingId])
  @@index([categoryId])
  @@map("listing_foxxer_services")
}

model Listing {
  id           String        @id @default(uuid())
  hostId       String
  categoryId   String?
  title        String
  description  String
  propertyType PropertyType?
  roomType     RoomType?
  status       ListingStatus @default(draft)
  type         ListingType   @default(venue)
  capacity     Int?
  maxAttendees Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  host                  User                   @relation("HostListings", fields: [hostId], references: [id], onDelete: Cascade)
  category              Category?              @relation("Category", fields: [categoryId], references: [id], onDelete: SetNull)
  location              ListingLocation?
  pricing               ListingPricing[]
  availability          ListingAvailability[]
  images                ListingImage[]
  amenities             ListingAmenity[]
  reviews               Review[]
  bookings              Booking[]
  favorites             Favorite[]
  listingFoxxerServices ListingFoxxerService[]

  @@index([hostId])
  @@index([categoryId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("listings")
}
