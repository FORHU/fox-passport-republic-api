generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  password        String
  name            String
  username        String?         @unique
  phone           String?
  imgId           String?
  systemRole      SystemRole      @default(user)
  roleType        RoleType[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  roleRequests    RoleRequest[]   @relation("Applicant")
  reviewsGiven    RoleRequest[]   @relation("Reviewer")
  // file relation
  files           File[]
  passport        Passport?
  assets          Asset[]
  services        Service[]
  venues          Venue[]
  clientEvents    EventClientRequest[]         @relation("EventClient")
  organizedEvents EventClientRequest[]         @relation("EventOrganizer")
  bookings        Booking[]
  favorites       Favorite[]
  reviews         Review[]
  eventTemplates      EventTemplate[]
  assetTransactions   EventAssetTransaction[]   @relation("AssetProvider")
  serviceTransactions EventServiceTransaction[] @relation("ServiceProvider")
  venueTransactions   EventVenueTransaction[]   @relation("VenueProvider")
}

model RoleRequest {
  id                        String                     @id @default(uuid())
  userId                    String
  roleType                  RoleType
  status                    RequestStatus              @default(pending)
  reviewedBy                String?
  reviewedAt                DateTime?
  rejectionReason           String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  files                     File[]
  user                      User                       @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer                  User?                      @relation("Reviewer", fields: [reviewedBy], references: [id])
  mayorApplication          MayorApplication?
  foxerAssetApplication     FoxerAssetApplication?
  foxerServiceApplication   FoxerServiceApplication?
  investorApplication       InvestorApplication?
  hostApplication HostApplication?

  @@index([userId, roleType])
  @@map("role_requests")
}

// APPLICATIONS
model MayorApplication {
  id              String      @id @default(uuid())
  requestId       String      @unique
  businessName    String
  contactNumber   String
  address         String
  tinNumber       String
  description     String?
  validId1FileId  String?
  nbiFileId       String?
  tinIdFileId     String?
  birPermitFileId String?
  selfieFileId    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  request         RoleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  validId1        File?       @relation("MayorValidId1", fields: [validId1FileId], references: [id])
  nbiFile         File?       @relation("MayorNBI", fields: [nbiFileId], references: [id])
  tinIdFile       File?       @relation("MayorTinId", fields: [tinIdFileId], references: [id])
  birPermitFile   File?       @relation("MayorBirPermit", fields: [birPermitFileId], references: [id])
  selfieFile      File?       @relation("MayorSelfie", fields: [selfieFileId], references: [id])
}

model FoxerAssetApplication {
  id              String      @id @default(uuid())
  requestId       String      @unique
  businessName    String
  assetTypes      String[]
  tinNumber       String
  validId1FileId  String?
  nbiFileId       String?
  tinIdFileId     String?
  birPermitFileId String?
  selfieFileId    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  request         RoleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  validId1        File?       @relation("FoxerAssetValidId1", fields: [validId1FileId], references: [id])
  nbiFile         File?       @relation("FoxerAssetNBI", fields: [nbiFileId], references: [id])
  tinIdFile       File?       @relation("FoxerAssetTinId", fields: [tinIdFileId], references: [id])
  birPermitFile   File?       @relation("FoxerAssetBirPermit", fields: [birPermitFileId], references: [id])
  selfieFile      File?       @relation("FoxerAssetSelfie", fields: [selfieFileId], references: [id])
}

model FoxerServiceApplication {
  id                   String      @id @default(uuid())
  requestId            String      @unique
  serviceTypes         String[]
  portfolioUrls        String[]
  experience           Int
  nbiClearanceIdNumber String
  tinNumber            String?
  validId1FileId       String?
  nbiFileId            String?
  tinIdFileId          String?
  birPermitFileId      String?
  selfieFileId         String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  request              RoleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  validId1             File?       @relation("ServiceValidId1", fields: [validId1FileId], references: [id])
  nbiFile              File?       @relation("ServiceNBI", fields: [nbiFileId], references: [id])
  tinIdFile            File?       @relation("ServiceTinId", fields: [tinIdFileId], references: [id])
  birPermitFile        File?       @relation("ServiceBirPermit", fields: [birPermitFileId], references: [id])
  selfieFile           File?       @relation("ServiceSelfie", fields: [selfieFileId], references: [id])
}

model InvestorApplication {
  id              String      @id @default(uuid())
  requestId       String      @unique
  companyName     String?
  investmentRange Float
  interests       String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  request         RoleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // 🔗 FILES
  proofOfFunds    File?       @relation("InvestorProof", fields: [proofFileId], references: [id])
  proofFileId     String?
}

model HostApplication {
  id              String      @id @default(uuid())
  requestId       String      @unique
  bio             String?
  experience      String?
  location        String?
  validId1FileId  String?
  nbiFileId       String?
  tinIdFileId     String?
  birPermitFileId String?
  selfieFileId    String?
  portfolioFileId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  request         RoleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  validId1        File?       @relation("HostValidId1", fields: [validId1FileId], references: [id])
  nbiFile         File?       @relation("HostNBI", fields: [nbiFileId], references: [id])
  tinIdFile       File?       @relation("HostTinId", fields: [tinIdFileId], references: [id])
  birPermitFile   File?       @relation("HostBirPermit", fields: [birPermitFileId], references: [id])
  selfieFile      File?       @relation("HostSelfie", fields: [selfieFileId], references: [id])
  portfolioFile   File?       @relation("HostPortfolio", fields: [portfolioFileId], references: [id])

  files File[] @relation("HostPortfolioMany")
}

model File {
  id               String                    @id @default(uuid())
  url              String
  name             String
  type             String
  uploadedBy       String?
  venueId          String?
  assetId          String?
  serviceId        String?
  roleRequestId    String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  deletedAt        DateTime?
  user             User?                     @relation(fields: [uploadedBy], references: [id])
  venue            Venue?                    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  asset            Asset?                    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  service          Service?                  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  roleRequest      RoleRequest?              @relation(fields: [roleRequestId], references: [id], onDelete: SetNull)
  // Mayor Application Relations
  mayorValidId1   MayorApplication[]        @relation("MayorValidId1")
  mayorNbi         MayorApplication[]        @relation("MayorNBI")
  mayorTinId       MayorApplication[]        @relation("MayorTinId")
  mayorBirPermit   MayorApplication[]        @relation("MayorBirPermit")
  mayorSelfie      MayorApplication[]        @relation("MayorSelfie")

  // Foxer Asset Application Relations
  foxerAssetValidId1   FoxerAssetApplication[]   @relation("FoxerAssetValidId1")
  foxerAssetNbi         FoxerAssetApplication[]   @relation("FoxerAssetNBI")
  foxerAssetTinId       FoxerAssetApplication[]   @relation("FoxerAssetTinId")
  foxerAssetBirPermit   FoxerAssetApplication[]   @relation("FoxerAssetBirPermit")
  foxerAssetSelfie      FoxerAssetApplication[]   @relation("FoxerAssetSelfie")

  // Foxer Service Application Relations
  foxerServiceValidId1  FoxerServiceApplication[] @relation("ServiceValidId1")
  foxerServiceNbi       FoxerServiceApplication[] @relation("ServiceNBI")
  foxerServiceTinId     FoxerServiceApplication[] @relation("ServiceTinId")
  foxerServiceBirPermit FoxerServiceApplication[] @relation("ServiceBirPermit")
  foxerServiceSelfie    FoxerServiceApplication[] @relation("ServiceSelfie")

  // Host Application Relations
  hostValidId1     HostApplication[] @relation("HostValidId1")
  hostNbi           HostApplication[] @relation("HostNBI")
  hostTinId         HostApplication[] @relation("HostTinId")
  hostBirPermit     HostApplication[] @relation("HostBirPermit")
  hostSelfie        HostApplication[] @relation("HostSelfie")
  hostPortfolio     HostApplication[] @relation("HostPortfolio")
  hostPortfolioMany HostApplication[] @relation("HostPortfolioMany")

  // Investor Request
  investorProof    InvestorApplication[]     @relation("InvestorProof")

  //Event Templates
  eventTemplates EventTemplate[] @relation("EventTemplateImages")
}

model Passport {
  id           String   @id @default(uuid())
  userId       String   @unique
  totalStamps  Int      @default(0)
  totalMileage Int      @default(0)
  level        Int      @default(1)
  achievements Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Asset {
  id                 String                   @id @default(uuid())
  ownerId            String
  category           String
  name               String
  description        String
  quantity           Int                      @default(1)
  price              Float
  currency           String                   @default("USD")
  billingRate        BillingRate
  condition          AssetCondition           @default(good)
  status             AssetStatus              @default(available)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  deletedAt          DateTime?
  images             File[]
  owner           User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  templateAssets  EventTemplateAsset[]
  transactions    EventAssetTransaction[]

  @@map("assets")
}

model Service {
  id                 String                   @id @default(uuid())
  ownerId            String
  category           String
  name               String
  description        String
  city               String                   @default("Unknown City")
  state              String?
  country            String                   @default("Unknown Country")
  isWillingToTravel  Boolean                  @default(false)
  tags               String[]
  price              Float
  currency           String                   @default("USD")
  billingRate        BillingRate
  status             ServiceStatus            @default(draft)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  deletedAt          DateTime?
  images             File[]
  owner            User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  templateServices EventTemplateService[]
  transactions     EventServiceTransaction[]

  @@map("services")
}

model Venue {
  id                 String                   @id @default(uuid())
  hostId             String
  category           String
  name               String
  description        String
  capacity           Int
  price              Float
  billingRate        BillingRate
  address            String
  city               String
  state              String?
  country            String
  status             VenueStatus              @default(draft)
  spaceType          String[]
  amenities          String[]
  techAv             String[]
  staffing           String[]
  policies           String[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  images             File[]
  host           User                  @relation(fields: [hostId], references: [id], onDelete: Cascade)
  templateVenues EventTemplateVenue[]
  transactions   EventVenueTransaction[]

  @@map("venues")
}

model EventTemplate {
  id               String                 @id @default(uuid())
  ownerId          String
  name             String
  description      String
  category         EventType
  isPublic         Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  owner            User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  events           EventClientRequest[]
  templateAssets   EventTemplateAsset[]
  templateServices EventTemplateService[]
  templateVenues   EventTemplateVenue[]

  images File[] @relation("EventTemplateImages")
}

model EventTemplateAsset {
  id         String        @id @default(uuid())
  templateId String
  assetId    String
  name       String?
  quantity   Int           @default(1)
  currency   String        @default("PHP")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  template   EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  asset      Asset         @relation(fields: [assetId], references: [id])

  @@map("event_template_assets")
}

model EventTemplateService {
  id         String        @id @default(uuid())
  templateId String
  serviceId  String
  name       String?
  currency   String        @default("PHP")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  template   EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  service    Service       @relation(fields: [serviceId], references: [id])

  @@map("event_template_services")
}

model EventTemplateVenue {
  id         String        @id @default(uuid())
  templateId String
  venueId    String
  name       String?
  currency   String        @default("PHP")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  template   EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  venue      Venue         @relation(fields: [venueId], references: [id])

  @@map("event_template_venues")
}

model EventClientRequest {
  id             String             @id @default(uuid())
  clientId       String
  organizerId    String
  templateId     String
  name           String
  description    String
  startAt        DateTime
  endAt          DateTime
  guestCount     Int
  totalAmount    Float
  eventStatus         EventStatus        @default(pending)
  requestStatus       RequestStatus       @default(pending)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  client         User               @relation("EventClient", fields: [clientId], references: [id])
  host User               @relation("EventOrganizer", fields: [organizerId], references: [id])
  template           EventTemplate      @relation(fields: [templateId], references: [id])
  assetTransactions  EventAssetTransaction[]
  serviceTransactions EventServiceTransaction[]
  venueTransactions  EventVenueTransaction[]
  bookings           Booking[]
}

model EventAssetTransaction {
  id          String            @id @default(uuid())
  eventId     String
  assetId     String
  providerId  String
  quantity    Int               @default(1)
  status      TransactionStatus @default(pending)
  agreedPrice Float
  currency    String            @default("PHP")
  lockedAt    DateTime?
  releasedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  event       EventClientRequest @relation(fields: [eventId], references: [id], onDelete: Cascade)
  provider    User              @relation("AssetProvider", fields: [providerId], references: [id])
  asset       Asset             @relation(fields: [assetId], references: [id])
}

model EventServiceTransaction {
  id          String            @id @default(uuid())
  eventId     String
  serviceId   String
  providerId  String
  status      TransactionStatus @default(pending)
  agreedPrice Float
  currency    String            @default("PHP")
  lockedAt    DateTime?
  releasedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  event       EventClientRequest @relation(fields: [eventId], references: [id], onDelete: Cascade)
  provider    User              @relation("ServiceProvider", fields: [providerId], references: [id])
  service     Service           @relation(fields: [serviceId], references: [id])
}

model EventVenueTransaction {
  id          String            @id @default(uuid())
  eventId     String
  venueId     String
  providerId  String
  status      TransactionStatus @default(pending)
  agreedPrice Float
  currency    String            @default("PHP")
  lockedAt    DateTime?
  releasedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  event       EventClientRequest @relation(fields: [eventId], references: [id], onDelete: Cascade)
  provider    User              @relation("VenueProvider", fields: [providerId], references: [id])
  venue       Venue             @relation(fields: [venueId], references: [id])
}

model Booking {
  id          String            @id @default(uuid())
  eventId     String
  userId      String
  guestCount  Int
  totalAmount Float
  status      BookingStatus     @default(pending)
  startAt     DateTime
  endAt       DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  event       EventClientRequest             @relation(fields: [eventId], references: [id])
  user        User              @relation(fields: [userId], references: [id])
  attendees   BookingAttendee[]
  payments    Payment[]
}

model BookingAttendee {
  id         String   @id @default(uuid())
  bookingId  String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  ticketCode String   @unique
  checkedIn  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String
  amount        Float
  currency      String
  method        String
  status        PaymentStatus
  transactionId String?       @unique
  paidAt        DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  entityId   String
  entityType String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  entityId   String
  entityType String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId, entityType])
}

enum ComponentType {
  asset
  service
  venue
}

enum SystemRole {
  user
  admin
}

enum RoleType {
  mayor
  host
  foxerAsset
  foxerService
  investor
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum EventStatus {
  draft
  pending
  ongoing
  completed
  cancelled
}

enum TransactionStatus {
  pending
  approved
  rejected
  cancelled
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum AssetCondition {
  new
  good
  fair
  refurbished
}

enum AssetStatus {
  draft
  pending
  available
  reserved
  archived
  rejected
}

enum ServiceStatus {
  draft
  pending
  available
  paused
  archived
  rejected
}

enum VenueStatus {
  draft
  pending
  available
  archived
  rejected
}

enum BillingRate {
  hourly
  daily
  weekly
  monthly
  yearly
  one_time
}

enum EventType {
  corporate
  fair
  birthday
  wedding
  anniversary
  graduation
  other
}
