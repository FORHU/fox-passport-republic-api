generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String
  name       String
  username   String?    @unique
  phone      String?
  imgId      String?
  role       UserRole   @default(user)
  isVerified Boolean    @default(false)
  isHost     Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  bookings   Booking[]
  favorites  Favorite[]
  passport   Passport?
  reviews    Review[]
  assets     Asset[]
  events     Event[]
  files      File[]
  services   Service[]
  venues     Venue[]
  renterAssets RenterAsset[]
  renterServices RenterService[]
  renterVenues RenterVenue[]

  @@map("users")
}

model File {
  id         String    @id @default(uuid())
  url        String
  name       String
  type       String
  uploadedBy String?
  venueId    String?
  assetId    String?
  serviceId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  user       User?     @relation(fields: [uploadedBy], references: [id])
  venue      Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  asset      Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  service    Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([assetId])
  @@index([serviceId])
  @@map("files")
}

model Passport {
  id           String   @id @default(uuid())
  userId       String   @unique
  totalStamps  Int      @default(0)
  totalMileage Int      @default(0)
  level        Int      @default(1)
  achievements Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Asset {
  id          String         @id @default(uuid())
  ownerId     String
  category    String
  name        String
  description String
  quantity    Int            @default(1)
  price       Float
  currency    String         @default("USD")
  billingRate BillingRate
  condition   AssetCondition @default(good)
  status      AssetStatus    @default(available)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  images      File[]
  renterAssets RenterAsset[]
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("assets")
}

model Service {
  id            String         @id @default(uuid())
  ownerId       String
  category      String
  name          String
  description   String
  city          String         @default("Unknown City")
  state         String?
  country       String         @default("Unknown Country")
  isWillingToTravel Boolean        @default(false)
  tags          String[]
  price         Float
  currency      String         @default("USD")  
  billingRate   BillingRate
  status        ServiceStatus  @default(draft)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  images        File[]
  renterServices RenterService[]
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("services")
}

model Venue {
  id          String       @id @default(uuid())
  hostId      String
  category    String
  name        String
  description String
  capacity    Int
  price       Float
  address     String
  city        String
  state       String?
  country     String
  status      VenueStatus  @default(draft)
  spaceType   String[]
  amenities   String[]
  techAv      String[]
  staffing    String[]
  policies    String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  images      File[]
  renterVenues RenterVenue[]
  host        User         @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@map("venues")
}

model Event {
  id            String         @id @default(uuid())
  organizerId   String
  imgId         String?
  name          String
  description   String
  eventType     EventType
  startAt       DateTime
  endAt         DateTime
  maxAttendees  Int
  totalPrice    Float
  currency      String         @default("PHP")
  status        EventStatus    @default(pending)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizer     User           @relation(fields: [organizerId], references: [id])

  bookings      Booking[]

  @@map("events")
}

model RenterAsset {
  id          String            @id @default(uuid())
  renterId    String
  assetId     String
  quantity    Int               @default(1)
  currency      String         @default("USD")    
  agreedPrice Float
  billingRate BillingRate
  status      TransactionStatus @default(available)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  asset       Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  renter      User              @relation(fields: [renterId], references: [id], onDelete: Cascade)

  @@unique([renterId, assetId])
}

model RenterService {
  id          String            @id @default(uuid())
  renterId    String
  serviceId   String
  currency      String         @default("USD")
  agreedPrice Float
  billingRate BillingRate
  status      TransactionStatus @default(available)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  renter      User              @relation(fields: [renterId], references: [id], onDelete: Cascade)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([renterId, serviceId])
}

model RenterVenue {
  id          String            @id @default(uuid())
  renterId    String
  venueId     String
  currency      String         @default("USD")
  agreedPrice Float
  billingRate BillingRate
  status      TransactionStatus @default(available)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  renter      User              @relation(fields: [renterId], references: [id], onDelete: Cascade)
  venue       Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([renterId, venueId])
}

model Booking {
  id          String            @id @default(uuid())
  eventId     String
  userId      String
  guestCount  Int
  totalAmount Float
  status      BookingStatus     @default(pending)
  startAt     DateTime
  endAt       DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  event       Event             @relation(fields: [eventId], references: [id])
  user        User              @relation(fields: [userId], references: [id])
  attendees   BookingAttendee[]
  payments    Payment[]
}

model BookingAttendee {
  id         String   @id @default(uuid())
  bookingId  String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  ticketCode String   @unique
  checkedIn  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String
  amount        Float
  currency      String
  method        String
  status        PaymentStatus
  transactionId String?       @unique
  paidAt        DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  entityId   String
  entityType String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  entityId   String
  entityType String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId, entityType])
}

enum UserRole {
  user
  mayor
  investor
  foxer
  admin
}

enum EventStatus {
  draft
  pending
  ongoing
  completed
  cancelled
}

enum TransactionStatus {
  available
  in_use
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum AssetCondition {
  new
  good
  fair
  refurbished
}

enum AssetStatus {
  draft
  pending
  available
  reserved
  archived
  rejected
}

enum ServiceStatus {
  draft
  pending
  available
  paused
  archived
  rejected
}

enum VenueStatus {
  draft
  pending
  available
  archived
  rejected
}

enum BillingRate {
  hourly
  daily
  weekly
  monthly
  yearly
  one_time
}

enum EventType {
  corporate
  fair
  birthday
  wedding
  anniversary
  graduation
  other
}
