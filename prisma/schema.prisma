generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums for better type safety
enum UserRole {
  user
  host
  admin
  super_admin
}

enum ListingStatus {
  draft
  pending_review
  action_required
  published
  hidden
  suspended
  archived
  banned
}

enum ListingType {
  venue
  equipment
  catering
  service
  event
}

enum BookingStatus {
  draft // NEW: for multi-step booking in progress
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  name         String
  username     String    @unique
  phone        String?
  profileImage String?
  dateOfBirth  DateTime?
  role         UserRole  @default(user)
  isFoxxer     Boolean   @default(false)
  isHost       Boolean   @default(false)
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  // Relations
  listings      Listing[]      @relation("HostListings")
  foxxerProfile FoxxerProfile?
  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@map("users")
}

model FoxxerProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  bio          String?
  skills       String?
  rating       Decimal? @default(0)
  totalReviews Int      @default(0)
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  services ListingFoxxerService[]

  @@map("foxxer_profiles")
}

model EventCategory {
  id      String  @id @default(uuid())
  name    String
  slug    String  @unique
  iconUrl String?

  // Relations
  foxxerServices ListingFoxxerService[]

  @@map("event_categories")
}

model ListingFoxxerService {
  id                 String   @id @default(uuid())
  foxxerId           String
  listingId          String
  categoryId         String
  serviceName        String
  serviceDescription String?
  price              Decimal
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  foxxer   FoxxerProfile @relation(fields: [foxxerId], references: [id], onDelete: Cascade)
  listing  Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([foxxerId])
  @@index([listingId])
  @@index([categoryId])
  @@map("listing_foxxer_services")
}

model Listing {
  id           String        @id @default(uuid())
  hostId       String
  categoryId   String?
  title        String
  description  String
  propertyType String? // From reference image
  roomType     String? // From reference image
  status       ListingStatus @default(draft)
  type         ListingType   @default(venue)
  maxAttendees Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  host                  User                   @relation("HostListings", fields: [hostId], references: [id], onDelete: Cascade)
  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location              ListingLocation?
  pricing               ListingPricing[]
  availability          ListingAvailability[]
  images                ListingImage[]
  amenities             ListingAmenity[]
  reviews               Review[]
  bookings              Booking[]
  favorites             Favorite[]
  listingFoxxerServices ListingFoxxerService[]

  @@index([hostId])
  @@index([categoryId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("listings")
}

model ListingLocation {
  id                 String    @id @default(uuid())
  listingId          String    @unique
  streetAddress      String // From reference image
  city               String
  state              String?
  country            String
  latitude           Decimal?
  longitude          Decimal?
  startDatetime      DateTime? // Retained for compatibility if needed
  endDatetime        DateTime? // Retained for compatibility if needed
  durationMinutes    Int?
  requirements       String?
  cancellationPolicy String?
  itineraryJson      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([country])
  @@map("listing_locations")
}

model ListingPricing {
  id                String    @id @default(uuid())
  listingId         String
  basePrice         Decimal
  currency          String
  serviceFeePercent Decimal
  taxPercent        Decimal
  pricingTiers      Json?
  earlyBirdDiscount Json?
  earlyBirdDeadline DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_pricing")
}

model ListingAvailability {
  id             String   @id @default(uuid())
  listingId      String
  availableDate  DateTime
  availableSlots Int
  bookedSlots    Int
  isAvailable    Boolean
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([availableDate])
  @@map("listing_availability")
}

model ListingImage {
  id          String   @id @default(uuid())
  listingId   String
  url         String // From reference image
  altText     String?
  orderIndex  Int? // From reference image (was displayOrder)
  isThumbnail Boolean  @default(false) // From reference image (was isPrimary)
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([isThumbnail])
  @@map("listing_images")
}

model Amenity {
  id        String           @id @default(uuid())
  name      String           @unique
  iconUrl   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  listings  ListingAmenity[]

  @@map("amenities")
}

model ListingAmenity {
  listingId String
  amenityId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
  @@map("listing_amenities")
}

model Category {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String?
  parentCategoryId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  parentCategory Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subCategories  Category[] @relation("CategoryHierarchy")
  listings       Listing[]

  @@index([slug])
  @@index([parentCategoryId])
  @@map("categories")
}

model Booking {
  id               String        @id @default(uuid())
  listingId        String
  userId           String
  guestCount       Int?
  totalAmount      Decimal?
  bookingStatus    BookingStatus @default(draft)
  confirmationCode String        @unique
  currentStep      Int           @default(1)
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  specialRequests  String?

  // Relations
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  listing   Listing           @relation(fields: [listingId], references: [id], onDelete: Restrict)
  attendees BookingAttendee[]
  payments  Payment[]

  @@index([userId])
  @@index([listingId])
  @@index([bookingStatus])
  @@index([confirmationCode])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("bookings")
}

model BookingAttendee {
  id          String    @id @default(uuid())
  bookingId   String
  firstName   String
  lastName    String
  email       String
  phone       String
  ticketCode  String    @unique
  checkedIn   Boolean   @default(false)
  checkInTime DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([ticketCode])
  @@index([checkedIn])
  @@map("booking_attendees")
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String
  amount          Decimal
  currency        String
  paymentMethod   String
  paymentStatus   PaymentStatus @default(pending)
  transactionId   String        @unique
  paymentDate     DateTime      @default(now())
  gatewayResponse String?

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([transactionId])
  @@index([paymentStatus])
  @@map("payments")
}

model Review {
  id                 String   @id @default(uuid())
  listingId          String
  userId             String
  rating             Int
  comment            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  isVerifiedAttendee Boolean  @default(false)

  // Relations
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  savedAt   DateTime @default(now())

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("favorites")
}
