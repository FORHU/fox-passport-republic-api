generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                    @id @default(uuid())
  email               String                    @unique
  password            String
  name                String
  address             String?
  city                String?
  state               String?
  country             String?                   @default("Philippines")
  username            String?                   @unique
  phone               String?
  imgId               String?
  systemRole          SystemRole                @default(user)
  roleType            RoleType[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  bookings            Booking[]
  serviceBookings     ServiceBooking[]
  assetBookings       AssetBooking[]
  assetTransactions   EventAssetTransaction[]   @relation("AssetProvider")
  clientEvents        Event[]                   @relation("EventClient")
  organizedEvents     Event[]                   @relation("EventOrganizer")
  serviceTransactions EventServiceTransaction[] @relation("ServiceProvider")
  eventTemplates      EventTemplate[]
  venueTransactions   EventVenueTransaction[]   @relation("VenueProvider")
  favorites           Favorite[]
  files               File[]
  passport            Passport?
  reviews             Review[]
  reviewReplies       ReviewReply[]
  assets              Asset[]
  reviewsGiven        RoleRequest[]             @relation("Reviewer")
  roleRequests        RoleRequest[]             @relation("Applicant")
  services            Service[]
  venues              Venue[]
  bookingAttendees    BookingAttendee[]
  invitedAttendees    BookingAttendee[]         @relation("Inviter")
  notifications       Notification[]
  waitlistEntries    Waitlist[]
  stripeCustomerId     String?                   @unique
  stripeChargesEnabled      Boolean             @default(false)
  stripePayoutsEnabled      Boolean             @default(false)
  isEmailVerified     Boolean                   @default(false)
  payouts                   Payout[]
  stripeAccountId          String?   @unique
  stripeOnboardingComplete Boolean   @default(false)
}


model RoleRequest {
  id                      String                   @id @default(uuid())
  userId                  String
  roleType                RoleType
  status                  RequestStatus            @default(pending)
  reviewedBy              String?
  reviewedAt              DateTime?
  rejectionReason         String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  gearFoxerApplication    GearFoxerApplication?
  serviceFoxerApplication ServiceFoxerApplication?
  eventFoxerApplication   EventFoxerApplication?
  investorApplication     InvestorApplication?
  venueFoxerApplication   VenueFoxerApplication?
  reviewer                User?                    @relation("Reviewer", fields: [reviewedBy], references: [id])
  user                    User                     @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, roleType])
  @@map("role_requests")
}

model VenueFoxerApplication {
  id              String      @id @default(uuid())
  requestId       String      @unique
  businessName    String
  contactNumber   String
  address         String
  tinNumber       String
  description     String?
  validId1FileId  String?
  nbiFileId       String?
  tinIdFileId     String?
  birPermitFileId String?
  selfieFileId    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  birPermitFile   File?       @relation("VenueFoxerBirPermit", fields: [birPermitFileId], references: [id])
  nbiFile         File?       @relation("VenueFoxerNBI", fields: [nbiFileId], references: [id])
  request         RoleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  selfieFile      File?       @relation("VenueFoxerSelfie", fields: [selfieFileId], references: [id])
  tinIdFile       File?       @relation("VenueFoxerTinId", fields: [tinIdFileId], references: [id])
  validId1        File?       @relation("VenueFoxerValidId1", fields: [validId1FileId], references: [id])
}

model GearFoxerApplication {
  id              String      @id @default(uuid())
  requestId       String      @unique
  businessName    String
  assetTypes      String[]
  tinNumber       String
  validId1FileId  String?
  nbiFileId       String?
  tinIdFileId     String?
  birPermitFileId String?
  selfieFileId    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  birPermitFile   File?       @relation("GearFoxerBirPermit", fields: [birPermitFileId], references: [id])
  nbiFile         File?       @relation("GearFoxerNBI", fields: [nbiFileId], references: [id])
  request         RoleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  selfieFile      File?       @relation("GearFoxerSelfie", fields: [selfieFileId], references: [id])
  tinIdFile       File?       @relation("GearFoxerTinId", fields: [tinIdFileId], references: [id])
  validId1        File?       @relation("GearFoxerValidId1", fields: [validId1FileId], references: [id])
}

model ServiceFoxerApplication {
  id                   String      @id @default(uuid())
  requestId            String      @unique
  serviceTypes         String[]
  portfolioUrls        String[]
  experience           Int
  nbiClearanceIdNumber String
  tinNumber            String?
  validId1FileId       String?
  nbiFileId            String?
  tinIdFileId          String?
  birPermitFileId      String?
  selfieFileId         String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  birPermitFile        File?       @relation("ServiceFoxerBirPermit", fields: [birPermitFileId], references: [id])
  nbiFile              File?       @relation("ServiceFoxerNBI", fields: [nbiFileId], references: [id])
  request              RoleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  selfieFile           File?       @relation("ServiceFoxerSelfie", fields: [selfieFileId], references: [id])
  tinIdFile            File?       @relation("ServiceFoxerTinId", fields: [tinIdFileId], references: [id])
  validId1             File?       @relation("ServiceFoxerValidId1", fields: [validId1FileId], references: [id])
}

model InvestorApplication {
  id              String      @id @default(uuid())
  requestId       String      @unique
  companyName     String?
  investmentRange Float
  interests       String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  proofFileId     String?
  proofOfFunds    File?       @relation("InvestorProof", fields: [proofFileId], references: [id])
  request         RoleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model EventFoxerApplication {
  id              String      @id @default(uuid())
  requestId       String      @unique
  bio             String?
  experience      String?
  location        String?
  validId1FileId  String?
  nbiFileId       String?
  tinIdFileId     String?
  birPermitFileId String?
  selfieFileId    String?
  portfolioFileId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  birPermitFile   File?       @relation("EventFoxerBirPermit", fields: [birPermitFileId], references: [id])
  nbiFile         File?       @relation("EventFoxerNBI", fields: [nbiFileId], references: [id])
  portfolioFile   File?       @relation("EventFoxerPortfolio", fields: [portfolioFileId], references: [id])
  request         RoleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  selfieFile      File?       @relation("EventFoxerSelfie", fields: [selfieFileId], references: [id])
  tinIdFile       File?       @relation("EventFoxerTinId", fields: [tinIdFileId], references: [id])
  validId1        File?       @relation("EventFoxerValidId1", fields: [validId1FileId], references: [id])
  files           File[]      @relation("EventFoxerPortfolioMany")
}

model File {
  id                    String                    @id @default(uuid())
  url                   String
  name                  String
  type                  String
  uploadedBy            String?
  venueId               String?
  assetId               String?
  serviceId             String?
  templateId            String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  deletedAt             DateTime?
  asset                 Asset?                    @relation(fields: [assetId], references: [id])
  service               Service?                  @relation(fields: [serviceId], references: [id])
  template              EventTemplate?            @relation(fields: [templateId], references: [id])
  user                  User?                     @relation(fields: [uploadedBy], references: [id])
  venue                 Venue?                    @relation(fields: [venueId], references: [id])
  gearFoxerBirPermit        GearFoxerApplication[]    @relation("GearFoxerBirPermit")
  gearFoxerNbi              GearFoxerApplication[]    @relation("GearFoxerNBI")
  gearFoxerSelfie           GearFoxerApplication[]    @relation("GearFoxerSelfie")
  gearFoxerTinId            GearFoxerApplication[]    @relation("GearFoxerTinId")
  gearFoxerValidId1         GearFoxerApplication[]    @relation("GearFoxerValidId1")
  serviceFoxerBirPermit     ServiceFoxerApplication[] @relation("ServiceFoxerBirPermit")
  serviceFoxerNbi           ServiceFoxerApplication[] @relation("ServiceFoxerNBI")
  serviceFoxerSelfie        ServiceFoxerApplication[] @relation("ServiceFoxerSelfie")
  serviceFoxerTinId         ServiceFoxerApplication[] @relation("ServiceFoxerTinId")
  serviceFoxerValidId1      ServiceFoxerApplication[] @relation("ServiceFoxerValidId1")
  eventFoxerBirPermit       EventFoxerApplication[]   @relation("EventFoxerBirPermit")
  eventFoxerNbi             EventFoxerApplication[]   @relation("EventFoxerNBI")
  eventFoxerPortfolio       EventFoxerApplication[]   @relation("EventFoxerPortfolio")
  eventFoxerSelfie          EventFoxerApplication[]   @relation("EventFoxerSelfie")
  eventFoxerTinId           EventFoxerApplication[]   @relation("EventFoxerTinId")
  eventFoxerValidId1        EventFoxerApplication[]   @relation("EventFoxerValidId1")
  investorProof             InvestorApplication[]     @relation("InvestorProof")
  venueFoxerBirPermit       VenueFoxerApplication[]   @relation("VenueFoxerBirPermit")
  venueFoxerNbi             VenueFoxerApplication[]   @relation("VenueFoxerNBI")
  venueFoxerSelfie          VenueFoxerApplication[]   @relation("VenueFoxerSelfie")
  venueFoxerTinId           VenueFoxerApplication[]   @relation("VenueFoxerTinId")
  venueFoxerValidId1        VenueFoxerApplication[]   @relation("VenueFoxerValidId1")
  eventFoxerPortfolioMany   EventFoxerApplication[]   @relation("EventFoxerPortfolioMany")
}

model Passport {
  id         String          @id @default(uuid())
  userId     String          @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paths      PassportPath[]
  stamps     PassportStamp[]
  userBadges UserBadge[]
}

model PassportPath {
  id         String   @id @default(uuid())
  passportId String
  path       UserPath
  level      Int      @default(1)
  currentXP  Int      @default(0)
  totalXP    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  passport   Passport @relation(fields: [passportId], references: [id], onDelete: Cascade)

  @@unique([passportId, path])
}

model Badge {
  id          String      @id @default(uuid())
  name        String      @unique
  description String
  icon        String
  color       String?
  rarity      BadgeRarity
  path        UserPath?
  criteria    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userBadges  UserBadge[]
}

model UserBadge {
  id         String   @id @default(uuid())
  passportId String
  badgeId    String
  earnedAt   DateTime @default(now())
  passport   Passport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([passportId, badgeId])
}

model PassportStamp {
  id         String   @id @default(uuid())
  passportId String
  bookingId  String   @unique
  eventName  String
  eventDate  DateTime
  location   String?
  xpEarned   Int
  imageUrl   String?
  createdAt  DateTime @default(now())
  passport   Passport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Asset {
  id               String                  @id @default(uuid())
  ownerId          String
  category         String
  name             String
  description      String
  quantity         Int                     @default(1)
  price            Float
  currency         String                  @default("USD")
  billingRate      BillingRate
  condition        AssetCondition          @default(good)
  status           AssetStatus             @default(available)
  rejectionReason  String?
  city             String?
  state            String?
  country          String?                 @default("Philippines")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?
  transactions     EventAssetTransaction[]
  images           File[]
  bookings         AssetBooking[]
  owner            User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  templateAssets   EventTemplateAsset[]
  cancellationPolicyId      String?
  cancellationPolicy  CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])

  @@map("assets")
}

model Service {
  id                String                    @id @default(uuid())
  ownerId           String
  category          ServiceCategory
  name              String
  description       String
  city              String                    @default("Unknown City")
  state             String?
  country           String                    @default("Unknown Country")
  isWillingToTravel Boolean                   @default(false)
  tags              String[]
  price             Float
  currency          String                    @default("USD")
  billingRate       BillingRate
  status            ServiceStatus             @default(draft)
  rejectionReason   String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  transactions      EventServiceTransaction[]
  images            File[]
  templateServices  EventTemplateService[]
  bookings          ServiceBooking[]
  owner             User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade) 
  cancellationPolicyId      String?
  cancellationPolicy  CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])

  @@map("services")
}

model Venue {
  id             String                  @id @default(uuid())
  mayorId        String
  category       String
  name           String
  description    String
  capacity       Int
  price          Float
  billingRate    BillingRate
  address        String
  city           String
  state          String?
  country        String
  status         VenueStatus             @default(draft)
  rejectionReason String?
  spaceType      String[]
  amenities      String[]
  techAv         String[]
  staffing       String[]
  policies       String[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  transactions   EventVenueTransaction[]
  images         File[]
  templateVenues EventTemplateVenue[]
  mayor          User                    @relation(fields: [mayorId], references: [id], onDelete: Cascade)
  cancellationPolicyId      String?
  cancellationPolicy  CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])

  @@map("venues")
}

model EventTemplate {
  id               String                 @id @default(uuid())
  ownerId          String
  name             String
  description      String
  category         EventCategory
  status           EventTemplateStatus    @default(draft)
  rejectionReason  String?
  isPublic         Boolean                @default(false)
  targetCity       String?
  targetState      String?
  targetCountry    String?                @default("Philippines")
  hostMarkupPct    Float                  @default(0)
  platformFeePct    Float                  @default(0.05) //might change later on
  maxAttendees     Int?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  events           Event[]
  images           File[]
  owner            User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cancellationPolicyId String?
  cancellationPolicy  CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  templateAssets   EventTemplateAsset[]
  templateServices EventTemplateService[]
  templateVenues   EventTemplateVenue[]
  waitlist         Waitlist[]
}

model EventTemplateAsset {
  id              String          @id @default(uuid())
  templateId      String
  assetId         String?
  description     String?
  quantity        Int             @default(1)
  currency        String          @default("PHP")
  agreedPrice     Float           @default(0)
  isOptional      Boolean         @default(false)
  date            DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  matched         Boolean         @default(false)
  matchedAt       DateTime?
  matchConstraint MatchConstraint @default(NONE)
  asset           Asset?          @relation(fields: [assetId], references: [id])
  template        EventTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("event_template_assets")
}

model EventTemplateService {
  id              String          @id @default(uuid())
  templateId      String
  serviceId       String?
  description     String?
  currency        String          @default("PHP")
  agreedPrice     Float           @default(0)
  isOptional      Boolean         @default(false)
  date            DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  matched         Boolean         @default(false)
  matchedAt       DateTime?
  matchConstraint MatchConstraint @default(NONE)
  service         Service?        @relation(fields: [serviceId], references: [id])
  template        EventTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("event_template_services")
}

model EventTemplateVenue {
  id              String          @id @default(uuid())
  templateId      String
  venueId         String?
  description     String?
  currency        String          @default("PHP")
  agreedPrice     Float           @default(0)
  isOptional      Boolean         @default(false)
  date            DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  matched         Boolean         @default(false)
  matchedAt       DateTime?
  matchConstraint MatchConstraint @default(NONE)
  template        EventTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  venue           Venue?          @relation(fields: [venueId], references: [id])

  @@map("event_template_venues")
}

model Event {
  id                  String                    @id @default(uuid())
  clientId            String
  organizerId         String
  templateId          String?
  name                String
  description         String
  eventCategory       EventCategory
  startAt             DateTime
  endAt               DateTime
  guestCount          Int
  totalAmount         Float
  itemsTotal          Float                     @default(0)
  hostMarkupAmount    Float                     @default(0)
  platformFeeAmount   Float                     @default(0)
  eventStatus         EventStatus               @default(pending)
  requestStatus       RequestStatus             @default(pending)
  rejectionReason     String?
  targetCity          String?
  targetState         String?
  targetCountry       String?                   @default("Philippines")
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  bookings            Booking[]
  assetTransactions   EventAssetTransaction[]
  client              User                      @relation("EventClient", fields: [clientId], references: [id])
  host                User                      @relation("EventOrganizer", fields: [organizerId], references: [id])
  template            EventTemplate?             @relation(fields: [templateId], references: [id])
  serviceTransactions EventServiceTransaction[]
  venueTransactions   EventVenueTransaction[]
}

model EventAssetTransaction {
  id          String            @id @default(uuid())
  eventId     String
  bookingId   String?
  assetId     String
  providerId  String
  quantity    Int               @default(1)
  status      TransactionStatus @default(pending)
  agreedPrice Float
  included    Boolean           @default(true)
  currency    String            @default("PHP")
  stripeTransferId String?       @unique
  disputeReason String?
  disputeAt   DateTime?
  lockedAt    DateTime?
  releasedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  asset       Asset             @relation(fields: [assetId], references: [id])
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  booking     Booking?          @relation(fields: [bookingId], references: [id])
  provider    User              @relation("AssetProvider", fields: [providerId], references: [id])
}

model EventServiceTransaction {
  id          String            @id @default(uuid())
  eventId     String
  bookingId   String?
  serviceId   String
  providerId  String
  status      TransactionStatus @default(pending)
  agreedPrice Float
  included    Boolean           @default(true)
  currency    String            @default("PHP")
  stripeTransferId String?       @unique
  disputeReason String?
  disputeAt   DateTime?
  lockedAt    DateTime?
  releasedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  booking     Booking?          @relation(fields: [bookingId], references: [id])
  provider    User              @relation("ServiceProvider", fields: [providerId], references: [id])
  service     Service           @relation(fields: [serviceId], references: [id])
}

model EventVenueTransaction {
  id          String            @id @default(uuid())
  eventId     String
  bookingId   String?
  venueId     String
  providerId  String
  status      TransactionStatus @default(pending)
  agreedPrice Float
  included    Boolean           @default(true)
  currency    String            @default("PHP")
  stripeTransferId String?       @unique
  disputeReason String?
  disputeAt   DateTime?
  lockedAt    DateTime?
  releasedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  booking     Booking?          @relation(fields: [bookingId], references: [id])
  provider    User              @relation("VenueProvider", fields: [providerId], references: [id])
  venue       Venue             @relation(fields: [venueId], references: [id])
}

model Booking {
  id                  String                    @id @default(uuid())
  eventId             String
  userId              String
  guestCount          Int
  totalAmount         Float
  hostMarkup         Float                   @default(0)
  platformFee        Float                   @default(0)
  stripePaymentId     String?                    @unique
  status              BookingStatus             @default(pending)
  startAt             DateTime
  endAt               DateTime
  expiresAt           DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  isGuestListLocked   Boolean                   @default(false)
  hasReview           Boolean                   @default(false)
  ticketCode          String?                   @unique
  checkedIn           Boolean                   @default(false)
  event               Event                     @relation(fields: [eventId], references: [id])
  user                User                      @relation(fields: [userId], references: [id])
  attendees           BookingAttendee[]
  payments            Payment[]
  assetTransactions   EventAssetTransaction[]
  serviceTransactions EventServiceTransaction[]
  venueTransactions   EventVenueTransaction[]
  reviews             Review[]
  refunds             Refund[]
  stamp               PassportStamp?
}

model BookingAttendee {
  id                 String       @id @default(uuid())
  bookingId          String
  userId             String?
  invitedById        String?
  firstName          String
  lastName           String
  email              String?
  phone              String?
  inviteStatus       InviteStatus @default(pending)
  isDraft            Boolean      @default(true)
  reasonForRejection String?
  ticketCode         String?      @unique
  checkedIn          Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  booking            Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user               User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy          User?        @relation("Inviter", fields: [invitedById], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String
  amount        Float
  currency      String
  method        String
  paymentType   PaymentType
  status        PaymentStatus
  transactionId String?       @unique
  expiresAt     DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  hostMarkupAmount Float       @default(0)
  platformFeeAmount Float     @default(0)
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds       Refund[]
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  entityId   String
  entityType String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  bookingId  String?
  entityId   String
  entityType String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking    Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId])
  @@index([userId, entityId, entityType])

  reviewReplies ReviewReply[]
}

model ReviewReply {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String
  text      String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceBooking {
  id                   String            @id @default(uuid())
  serviceId            String
  userId               String
  scheduledDate        DateTime
  endDate              DateTime?
  guestCount           Int               @default(1)
  location             String
  notes                String?
  totalAmount          Float
  platformFee          Float            @default(0)
  platformFeeAmount    Float             @default(0)
  status               ItemBookingStatus @default(pending)
  paymentStatus        PaymentStatus     @default(pending)
  paymentTransactionId String?
  stripePaymentId      String?           @unique
  paymentMethod        String?
  disputeReason        String?
  disputeAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  service              Service           @relation(fields: [serviceId], references: [id])
  user                 User              @relation(fields: [userId], references: [id])

  @@map("service_bookings")
}

model AssetBooking {
  id                   String            @id @default(uuid())
  assetId              String
  userId               String
  startDate            DateTime
  endDate              DateTime
  quantity             Int               @default(1)
  fulfillmentType      String            @default("pickup")
  deliveryAddress      String?
  notes                String?
  totalAmount          Float
  platformFee          Float            @default(0)
  platformFeeAmount    Float             @default(0)
  status               ItemBookingStatus @default(pending)
  paymentStatus        PaymentStatus     @default(pending)
  paymentTransactionId String?
  stripePaymentId      String?           @unique
  paymentMethod        String?
  disputeReason        String?
  disputeAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  asset                Asset             @relation(fields: [assetId], references: [id])
  user                 User              @relation(fields: [userId], references: [id])

  @@map("asset_bookings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
} 
model Payout {
  id               String       @id @default(uuid())
  recipientId      String
  role             RoleType
  sourceType       String // "assetBooking" | "serviceBooking" | "booking"
  sourceId         String
  amount           Float
  currency         String       @default("PHP")
  stripeTransferId String?
  status           PayoutStatus @default(pending)
  failureReason    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  recipient        User         @relation(fields: [recipientId], references: [id])

  @@unique([sourceType, sourceId, recipientId, role])
  @@index([sourceType, sourceId])
  @@index([recipientId])
  @@map("payouts")
}

model Refund {
  id             String       @id @default(uuid())
  bookingId      String
  paymentId      String?
  amount         Float
  currency       String       @default("PHP")
  stripeRefundId String?      @unique
  status         RefundStatus @default(pending)
  failureReason  String?
  failureCode    String?
  initiatedBy    String?
  resolved       Boolean      @default(false)
  resolvedBy     String?
  resolvedAt     DateTime?
  adminNotes     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment        Payment?     @relation(fields: [paymentId], references: [id])

  @@index([bookingId])
  @@index([status])
  @@map("refunds")
}

model CancellationPolicy {
  id          String   @id @default(uuid())
  name        String   //"Flexible", "Moderate", "Strict"
  asset       Asset[]
  venue       Venue[]
  service     Service[]
  templates   EventTemplate[]
  description String?
  isActive    Boolean  @default(true)
  rules       CancellationRule[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cancellation_policies")
}

model CancellationRule {
  id       String   @id @default(uuid())
  policyId String
  hoursBeforeEvent Int
  refundPercent    Int
  policy   CancellationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
}

