generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums for better type safety
enum UserRole {
  user
  host
  foxer
  admin
  super_admin
}

enum EventStatus {
  draft
  active
  cancelled
  completed
}

enum VenueStatus {
  draft
  active
  inactive
  under_maintenance
}

enum BookingStatus {
  draft // NEW: for multi-step booking in progress
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  name         String
  username     String    @unique
  phone        String?
  profileImage String?
  dateOfBirth  DateTime?
  role         UserRole  @default(user)
  isHost       Boolean   @default(false)
  isFoxer      Boolean   @default(false)
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  // Relations
  venues    Venue[]   @relation("HostVenues")
  events    Event[]    @relation("FoxerEvents")
  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@map("users")
}

// Venues created by Hosts
model Venue {
  id           String       @id @default(uuid())
  hostId       String
  categoryId   String?
  name         String
  description  String
  venueType    String       // hotel, land, hall, outdoor space, etc.
  capacity     Int?
  status       VenueStatus  @default(draft)
  isPublished  Boolean      @default(false)
  address      String
  city         String
  state        String
  country      String
  latitude     Decimal?
  longitude    Decimal?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  host         User         @relation("HostVenues", fields: [hostId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amenities    VenueAmenity[]
  pricing      VenuePricing[]
  images       VenueImage[]
  reviews      VenueReview[]
  events       Event[]      // Events using this venue

  @@index([hostId])
  @@index([categoryId])
  @@index([status])
  @@index([isPublished])
  @@index([city])
  @@index([createdAt])
}

model VenueAmenity {
  id        String   @id @default(uuid())
  venueId   String
  name      String   // WiFi, Parking, Kitchen, etc.
  icon      String?
  createdAt DateTime @default(now())

  // Relations
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model VenuePricing {
  id            String   @id @default(uuid())
  venueId       String
  pricePerDay   Decimal
  pricePerHour  Decimal?
  currency      String   @default("PHP")
  minHours      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model VenueImage {
  id           String   @id @default(uuid())
  venueId      String
  imageUrl     String
  altText      String?
  displayOrder Int?
  isPrimary    Boolean  @default(false)
  uploadedAt   DateTime @default(now())

  // Relations
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([isPrimary])
}

model VenueReview {
  id        String   @id @default(uuid())
  venueId   String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  // Relations
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([userId])
}

// Events created by Foxers (using Venues)
model Event {
  id           String      @id @default(uuid())
  foxerId      String      // Foxer who created the event
  venueId      String?     // Optional: Link to venue if using one
  categoryId   String?
  title        String
  description  String
  status       EventStatus @default(draft)
  maxAttendees Int?
  isPublished  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  foxer        User                @relation("FoxerEvents", fields: [foxerId], references: [id], onDelete: Cascade)
  venue        Venue?              @relation(fields: [venueId], references: [id], onDelete: SetNull)
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  details      EventDetails?
  pricing      EventPricing[]
  availability EventAvailability[]
  images       EventImage[]
  reviews      Review[]
  bookings     Booking[]
  favorites    Favorite[]

  @@index([foxerId])
  @@index([venueId])
  @@index([categoryId])
  @@index([status])
  @@index([isPublished])
  @@index([createdAt])
  @@map("events")
}

model EventDetails {
  id                 String   @id @default(uuid())
  eventId            String   @unique
  locationAddress    String
  city               String
  state              String
  country            String
  latitude           Decimal?
  longitude          Decimal?
  startDatetime      DateTime
  endDatetime        DateTime
  durationMinutes    Int?
  requirements       String?
  cancellationPolicy String?
  itineraryJson      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([startDatetime])
  @@index([city])
  @@index([country])
  @@map("event_details")
}

model EventPricing {
  id                String    @id @default(uuid())
  eventId           String
  basePrice         Decimal
  currency          String
  serviceFeePercent Decimal
  taxPercent        Decimal
  pricingTiers      Json?
  earlyBirdDiscount Json?
  earlyBirdDeadline DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_pricing")
}

model EventAvailability {
  id             String   @id @default(uuid())
  eventId        String
  availableDate  DateTime
  availableSlots Int
  bookedSlots    Int
  isAvailable    Boolean
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([availableDate])
  @@map("event_availability")
}

model EventImage {
  id           String   @id @default(uuid())
  eventId      String
  imageUrl     String
  altText      String?
  displayOrder Int?
  isPrimary    Boolean  @default(false)
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([isPrimary])
  @@map("event_images")
}

model Category {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String?
  icon             String?
  parentCategoryId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  parentCategory Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subCategories  Category[] @relation("CategoryHierarchy")
  venues         Venue[]
  events         Event[]

  @@index([slug])
  @@index([parentCategoryId])
  @@map("categories")
}

model Booking {
  id               String        @id @default(uuid())
  eventId          String
  userId           String
  numberOfTickets  Int? // CHANGED: Made optional for draft bookings
  totalAmount      Decimal? // CHANGED: Made optional for draft bookings
  bookingStatus    BookingStatus @default(draft) // CHANGED: Default to draft
  confirmationCode String        @unique
  currentStep      Int           @default(1) // NEW: Track booking progress (1-4)
  expiresAt        DateTime? // NEW: Expiry time for draft bookings (30 mins)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  specialRequests  String?

  // Relations
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  attendees BookingAttendee[]
  payments  Payment[]

  @@index([userId])
  @@index([eventId])
  @@index([bookingStatus])
  @@index([confirmationCode])
  @@index([createdAt])
  @@index([expiresAt]) // NEW: For cleanup queries
  @@map("bookings")
}

model BookingAttendee {
  id          String    @id @default(uuid())
  bookingId   String
  firstName   String
  lastName    String
  email       String
  phone       String
  ticketCode  String    @unique
  checkedIn   Boolean   @default(false)
  checkInTime DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([ticketCode])
  @@index([checkedIn])
  @@map("booking_attendees")
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String
  amount          Decimal
  currency        String
  paymentMethod   String
  paymentStatus   PaymentStatus @default(pending)
  transactionId   String        @unique
  paymentDate     DateTime      @default(now())
  gatewayResponse String?

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([transactionId])
  @@index([paymentStatus])
  @@map("payments")
}

model Review {
  id                 String   @id @default(uuid())
  eventId            String
  userId             String
  rating             Int
  comment            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  isVerifiedAttendee Boolean  @default(false)

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

model Favorite {
  id      String   @id @default(uuid())
  userId  String
  eventId String
  savedAt DateTime @default(now())

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("favorites")
}
