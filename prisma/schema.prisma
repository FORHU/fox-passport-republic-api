generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String
  name       String
  username   String?    @unique
  phone      String?
  imgId      String?
  role       UserRole   @default(user)
  isVerified Boolean    @default(false)
  isHost     Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  bookings   Booking[]
  favorites  Favorite[]
  passport   Passport?
  reviews    Review[]
  assets     Asset[]
  events     Event[]
  files      File[]
  services   Service[]
  venues     Venue[]

  @@map("users")
}

model File {
  id         String    @id @default(uuid())
  url        String
  name       String
  type       String
  uploadedBy String?
  venueId    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  user       User?     @relation(fields: [uploadedBy], references: [id])
  venue      Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@map("files")
}

model Passport {
  id           String   @id @default(uuid())
  userId       String   @unique
  totalStamps  Int      @default(0)
  totalMileage Int      @default(0)
  level        Int      @default(1)
  achievements Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Asset {
  id          String         @id @default(uuid())
  ownerId     String
  category    String
  name        String
  description String
  price       Float
  billingRate BillingRate
  imgId       String?
  condition   AssetCondition @default(good)
  status      AssetStatus    @default(available)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  eventAssets EventAsset[]
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("assets")
}

model Service {
  id            String         @id @default(uuid())
  ownerId       String
  category      String
  name          String
  description   String
  price         Float
  billingRate   BillingRate
  status        ServiceStatus  @default(pending)
  imgId         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  eventServices EventService[]
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("services")
}

model Venue {
  id          String       @id @default(uuid())
  hostId      String
  category    String
  name        String
  description String
  capacity    Int
  price       Float
  address     String
  city        String
  state       String?
  country     String
  status      VenueStatus  @default(draft)
  spaceType   String[]
  amenities   String[]
  techAv      String[]
  staffing    String[]
  policies    String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  images      File[]
  eventVenues EventVenue[]
  events      Event[]
  host        User         @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@map("venues")
}

model Event {
  id            String         @id @default(uuid())
  venueId       String
  organizerId   String
  imgId         String?
  name          String
  description   String
  eventType     EventType
  startAt       DateTime
  endAt         DateTime
  maxAttendees  Int
  totalPrice    Float
  currency      String         @default("PHP")
  status        EventStatus    @default(pending)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bookings      Booking[]
  eventAssets   EventAsset[]
  eventServices EventService[]
  eventVenues   EventVenue[]
  organizer     User           @relation(fields: [organizerId], references: [id])
  venue         Venue          @relation(fields: [venueId], references: [id])

  @@map("events")
}

model EventAsset {
  id          String            @id @default(uuid())
  eventId     String
  assetId     String
  quantity    Int               @default(1)
  agreedPrice Float
  billingRate BillingRate
  status      TransactionStatus @default(pending)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  asset       Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, assetId])
}

model EventService {
  id          String            @id @default(uuid())
  eventId     String
  serviceId   String
  agreedPrice Float
  billingRate BillingRate
  status      TransactionStatus @default(pending)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([eventId, serviceId])
}

model EventVenue {
  id          String            @id @default(uuid())
  eventId     String
  venueId     String
  agreedPrice Float
  billingRate BillingRate
  status      TransactionStatus @default(pending)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue       Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([eventId, venueId])
}

model Booking {
  id          String            @id @default(uuid())
  eventId     String
  userId      String
  guestCount  Int
  totalAmount Float
  status      BookingStatus     @default(pending)
  startAt     DateTime
  endAt       DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  event       Event             @relation(fields: [eventId], references: [id])
  user        User              @relation(fields: [userId], references: [id])
  attendees   BookingAttendee[]
  payments    Payment[]
}

model BookingAttendee {
  id         String   @id @default(uuid())
  bookingId  String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  ticketCode String   @unique
  checkedIn  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String
  amount        Float
  currency      String
  method        String
  status        PaymentStatus
  transactionId String?       @unique
  paidAt        DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  entityId   String
  entityType String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  entityId   String
  entityType String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId, entityType])
}

enum UserRole {
  user
  mayor
  investor
  foxer
  admin
}

enum EventStatus {
  draft
  pending
  ongoing
  completed
  cancelled
}

enum TransactionStatus {
  pending
  approved
  rejected
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum AssetCondition {
  new
  good
  fair
  refurbished
}

enum AssetStatus {
  draft
  pending
  available
  reserved
  archived
  rejected
}

enum ServiceStatus {
  draft
  pending
  available
  paused
  archived
  rejected
}

enum VenueStatus {
  draft
  pending
  available
  archived
  rejected
}

enum BillingRate {
  hourly
  daily
  weekly
  monthly
  yearly
  one_time
}

enum EventType {
  corporate
  fair
  birthday
  wedding
  anniversary
  graduation
  other
}
