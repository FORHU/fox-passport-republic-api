generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String
  username String? @unique
  phone    String?
  imgId    String?
  systemRole   SystemRole    @default(user)
  roleType     RoleType[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  roleRequests RoleRequest[] @relation("Applicant")
  reviewsGiven RoleRequest[] @relation("Reviewer")
  // file relation
  files     File[]
  passport  Passport?
  assets    Asset[]
  services  Service[]
  venues    Venue[]
  events    Event[]
  bookings  Booking[]
  favorites Favorite[]
  reviews   Review[]
  renterAssets RenterAsset[]
  renterServices RenterService[]
  renterVenues RenterVenue[]
}

model RoleRequest {
  id       String        @id @default(uuid())
  userId   String
  roleType RoleType
  status   RequestStatus @default(pending)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user            User          @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer        User?         @relation("Reviewer", fields: [reviewedBy], references: [id])
  mayorApplication        MayorApplication?
  foxerAssetApplication   FoxerAssetApplication?
  foxerServiceApplication FoxerServiceApplication?
  investorApplication     InvestorApplication?

  @@index([userId, roleType])
  @@map("role_requests")
}


// APPLICATIONS
model MayorApplication {
  id        String @id @default(uuid())
  requestId String @unique
  businessName  String
  contactNumber String
  address       String
  tinNumber     String
  description   String?
  validIdFileId   String?
  tinIdFileId     String?
  birPermitFileId String?
  selfieFileId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  request RoleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  validId       File? @relation("MayorValidId", fields: [validIdFileId], references: [id])
  tinIdFile     File? @relation("MayorTinId", fields: [tinIdFileId], references: [id])
  birPermitFile File? @relation("MayorBirPermit", fields: [birPermitFileId], references: [id])
  selfieFile    File? @relation("MayorSelfie", fields: [selfieFileId], references: [id])
}


model FoxerAssetApplication {
  id        String @id @default(uuid())
  requestId String @unique
  businessName String
  assetTypes   String[]
  tinNumber    String
  validIdFileId   String?
  tinIdFileId     String?
  birPermitFileId String?
  selfieFileId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  request RoleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  validId       File? @relation("FoxerAssetValidId", fields: [validIdFileId], references: [id])
  tinIdFile     File? @relation("FoxerAssetTinId", fields: [tinIdFileId], references: [id])
  birPermitFile File? @relation("FoxerAssetBirPermit", fields: [birPermitFileId], references: [id])
  selfieFile    File? @relation("FoxerAssetSelfie", fields: [selfieFileId], references: [id])
}


model FoxerServiceApplication {
  id        String @id @default(uuid())
  requestId String @unique
  serviceTypes         String[]
  portfolioUrls        String[]
  experience           Int
  nbiClearanceIdNumber String
  tinNumber            String?
  validId1FileId  String?
  validId2FileId  String?
  nbiFileId       String?
  tinIdFileId     String?
  birPermitFileId String?
  selfieFileId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  request RoleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  validId1      File? @relation("ServiceValidId1", fields: [validId1FileId], references: [id])
  validId2      File? @relation("ServiceValidId2", fields: [validId2FileId], references: [id])
  nbiFile       File? @relation("ServiceNBI", fields: [nbiFileId], references: [id])
  tinIdFile     File? @relation("ServiceTinId", fields: [tinIdFileId], references: [id])
  birPermitFile File? @relation("ServiceBirPermit", fields: [birPermitFileId], references: [id])
  selfieFile    File? @relation("ServiceSelfie", fields: [selfieFileId], references: [id])
}

model InvestorApplication {
  id        String @id @default(uuid())
  requestId String @unique
  companyName     String?
  investmentRange Float
  interests       String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  request RoleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // 🔗 FILES
  proofOfFunds File?   @relation("InvestorProof", fields: [proofFileId], references: [id])
  proofFileId  String?
}

model File {
  id         String    @id @default(uuid())
  url        String
  name       String
  type       String
  uploadedBy String?
  venueId    String?
  assetId    String?
  serviceId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  user       User?     @relation(fields: [uploadedBy], references: [id])
  venue      Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  asset      Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  service    Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  // Mayor Request
  mayorValidId   MayorApplication[] @relation("MayorValidId")
  mayorTinId     MayorApplication[] @relation("MayorTinId")
  mayorBirPermit MayorApplication[] @relation("MayorBirPermit")
  mayorSelfie    MayorApplication[] @relation("MayorSelfie")
  // Foxer Asset Request
  foxerValidId   FoxerAssetApplication[] @relation("FoxerAssetValidId")
  foxerTinId     FoxerAssetApplication[] @relation("FoxerAssetTinId")
  foxerBirPermit FoxerAssetApplication[] @relation("FoxerAssetBirPermit")
  foxerSelfie    FoxerAssetApplication[] @relation("FoxerAssetSelfie")
  //Foxer Service
  serviceValidId1  FoxerServiceApplication[] @relation("ServiceValidId1")
  serviceValidId2  FoxerServiceApplication[] @relation("ServiceValidId2")
  serviceNbi       FoxerServiceApplication[] @relation("ServiceNBI")
  serviceTinId     FoxerServiceApplication[] @relation("ServiceTinId")
  serviceBirPermit FoxerServiceApplication[] @relation("ServiceBirPermit")
  serviceSelfie    FoxerServiceApplication[] @relation("ServiceSelfie")
  // Investor Request
  investorProof InvestorApplication[] @relation("InvestorProof")
  @@index([venueId])
  @@index([assetId])
  @@index([serviceId])
  @@map("files")
}

model Passport {
  id           String   @id @default(uuid())
  userId       String   @unique
  totalStamps  Int      @default(0)
  totalMileage Int      @default(0)
  level        Int      @default(1)
  achievements Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Asset {
  id          String         @id @default(uuid())
  ownerId     String
  category    String
  name        String
  description String
  quantity    Int            @default(1)
  price       Float
  currency    String         @default("USD")
  billingRate BillingRate
  condition   AssetCondition @default(good)
  status      AssetStatus    @default(available)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  images      File[]
  renterAssets RenterAsset[]
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("assets")
}

model Service {
  id            String         @id @default(uuid())
  ownerId       String
  category      String
  name          String
  description   String
  city          String         @default("Unknown City")
  state         String?
  country       String         @default("Unknown Country")
  isWillingToTravel Boolean        @default(false)
  tags          String[]
  price         Float
  currency      String         @default("USD")  
  billingRate   BillingRate
  status        ServiceStatus  @default(draft)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  images        File[]
  renterServices RenterService[]
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("services")
}

model Venue {
  id          String       @id @default(uuid())
  hostId      String
  category    String
  name        String
  description String
  capacity    Int
  price       Float
  address     String
  city        String
  state       String?
  country     String
  status      VenueStatus  @default(draft)
  spaceType   String[]
  amenities   String[]
  techAv      String[]
  staffing    String[]
  policies    String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  images      File[]
  renterVenues RenterVenue[]
  host        User         @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@map("venues")
}

model Event {
  id            String         @id @default(uuid())
  organizerId   String
  imgId         String?
  name          String
  description   String
  eventType     EventType
  startAt       DateTime
  endAt         DateTime
  maxAttendees  Int
  totalPrice    Float
  currency      String         @default("PHP")
  status        EventStatus    @default(pending)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizer     User           @relation(fields: [organizerId], references: [id])

  bookings      Booking[]

  @@map("events")
}

model RenterAsset {
  id          String            @id @default(uuid())
  renterId    String
  assetId     String
  quantity    Int               @default(1)
  currency      String         @default("USD")    
  agreedPrice Float
  billingRate BillingRate
  status      TransactionStatus @default(available)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  asset       Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  renter      User              @relation(fields: [renterId], references: [id], onDelete: Cascade)

  @@unique([renterId, assetId])
}

model RenterService {
  id          String            @id @default(uuid())
  renterId    String
  serviceId   String
  currency      String         @default("USD")
  agreedPrice Float
  billingRate BillingRate
  status      TransactionStatus @default(available)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  renter      User              @relation(fields: [renterId], references: [id], onDelete: Cascade)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([renterId, serviceId])
}

model RenterVenue {
  id          String            @id @default(uuid())
  renterId    String
  venueId     String
  currency      String         @default("USD")
  agreedPrice Float
  billingRate BillingRate
  status      TransactionStatus @default(available)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  renter      User              @relation(fields: [renterId], references: [id], onDelete: Cascade)
  venue       Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([renterId, venueId])
}

model Booking {
  id          String            @id @default(uuid())
  eventId     String
  userId      String
  guestCount  Int
  totalAmount Float
  status      BookingStatus     @default(pending)
  startAt     DateTime
  endAt       DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  event       Event             @relation(fields: [eventId], references: [id])
  user        User              @relation(fields: [userId], references: [id])
  attendees   BookingAttendee[]
  payments    Payment[]
}

model BookingAttendee {
  id         String   @id @default(uuid())
  bookingId  String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  ticketCode String   @unique
  checkedIn  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String
  amount        Float
  currency      String
  method        String
  status        PaymentStatus
  transactionId String?       @unique
  paidAt        DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  entityId   String
  entityType String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  entityId   String
  entityType String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId, entityType])
}

enum SystemRole {
  user
  admin
}


enum RoleType {
  mayor
  foxerAsset
  foxerService
  investor
}


enum RequestStatus {
  pending
  approved
  rejected
}


enum EventStatus {
  draft
  pending
  ongoing
  completed
  cancelled
}

enum TransactionStatus {
  available
  in_use
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum AssetCondition {
  new
  good
  fair
  refurbished
}

enum AssetStatus {
  draft
  pending
  available
  reserved
  archived
  rejected
}

enum ServiceStatus {
  draft
  pending
  available
  paused
  archived
  rejected
}

enum VenueStatus {
  draft
  pending
  available
  archived
  rejected
}

enum BillingRate {
  hourly
  daily
  weekly
  monthly
  yearly
  one_time
}

enum EventType {
  corporate
  fair
  birthday
  wedding
  anniversary
  graduation
  other
}
