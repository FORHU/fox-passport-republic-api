generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// MODELS
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  username     String?  @unique
  profileImage String?
  phone        String?
  role         UserRole @default(user)

  isVerified Boolean @default(false)
  isHost     Boolean @default(false)
  isFoxer    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedVenues     Venue[]    @relation("VenueHost")
  ownedAssets     Asset[]    @relation("AssetOwner")
  organizedEvents Event[]    @relation("EventOrganizer")
  bookings        Booking[]  @relation("UserBookings")
  passport        Passport?
  reviews         Review[]
  favorites       Favorite[]
  services        Service[]  @relation("ServiceOwner")
}

model Venue {
  id          String      @id @default(uuid())
  hostId      String
  name        String
  description String
  type        VenueType
  capacity    Int
  status      VenueStatus @default(draft)
  address     String
  city        String
  state       String?
  country     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  host        User         @relation("VenueHost", fields: [hostId], references: [id], onDelete: Cascade)
  events      Event[]
  venueImages VenueImage[]
}

model VenueImage {
  id          String  @id @default(uuid())
  venueId     String
  url         String
  altText     String?
  orderIndex  Int?
  isThumbnail Boolean @default(false)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model Asset {
  id           String         @id @default(uuid())
  ownerId      String
  name         String
  description  String
  category     AssetCategory
  storageType  StorageType
  quantity     Int
  condition    AssetCondition
  pricePerUnit Float
  currency     String         @default("PHP")
  status       AssetStatus    @default(available)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  owner       User         @relation("AssetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  eventAssets EventAsset[]
  images      AssetImage[]
}

model AssetImage {
  id          String  @id @default(uuid())
  assetId     String
  url         String
  altText     String?
  orderIndex  Int?
  isThumbnail Boolean @default(false)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Service {
  id          String          @id @default(uuid())
  ownerId     String
  name        String
  description String
  category    ServiceCategory
  price       Float
  status      ServiceStatus   @default(active)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner         User           @relation("ServiceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  eventServices EventService[]
}

model Event {
  id            String      @id @default(uuid())
  venueId       String
  organizerId   String
  name          String
  description   String
  eventType     EventType
  startDatetime DateTime
  endDatetime   DateTime
  maxAttendees  Int
  totalPrice    Float
  currency      String      @default("PHP")
  status        EventStatus @default(draft)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  venue         Venue          @relation(fields: [venueId], references: [id])
  organizer     User           @relation("EventOrganizer", fields: [organizerId], references: [id])
  eventAssets   EventAsset[]
  eventServices EventService[]
  bookings      Booking[]
}

// Join table: Event <-> Asset (many-to-many)
model EventAsset {
  id       String @id @default(uuid())
  eventId  String
  assetId  String
  quantity Int

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([eventId, assetId])
}

// Join table: Event <-> Service (many-to-many)
model EventService {
  id          String @id @default(uuid())
  eventId     String
  serviceId   String
  agreedPrice Float

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([eventId, serviceId])
}

model Booking {
  id               String        @id @default(uuid())
  eventId          String
  userId           String
  guestCount       Int
  totalAmount      Float
  confirmationCode String?       @unique
  stampsEarned     Int           @default(0)
  currentStep      Int?          @default(1)
  status           BookingStatus @default(pending)
  specialRequests  String?
  start            DateTime      @default(now())
  end              DateTime      @default(now())
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  event     Event             @relation(fields: [eventId], references: [id])
  user      User              @relation("UserBookings", fields: [userId], references: [id])
  payments  Payment[]
  attendees BookingAttendee[]
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String
  amount          Float
  currency        String
  paymentMethod   String
  paymentStatus   PaymentStatus
  paymentDate     DateTime      @default(now())
  transactionId   String?       @unique
  gatewayResponse String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingAttendee {
  id          String    @id @default(uuid())
  bookingId   String
  firstName   String
  lastName    String
  email       String?
  phone       String?
  ticketCode  String    @unique
  checkedIn   Boolean   @default(false)
  checkInTime DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Passport {
  id           String   @id @default(uuid())
  userId       String   @unique
  totalStamps  Int      @default(0)
  totalMileage Int      @default(0)
  level        Int      @default(1)
  achievements Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id                 String   @id @default(uuid())
  venueId            String?
  eventId            String?
  userId             String
  rating             Int
  comment            String?
  isVerifiedAttendee Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  venueId   String?
  eventId   String?
  savedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ENUMS

enum UserRole {
  user
  mayor
  investor
  foxer
  admin
}

enum VenueType {
  hotel
  resort
  hall
  garden
  beach
  rooftop
  other
}

enum VenueStatus {
  draft
  pending_review
  published
  suspended
  archived
}

enum AssetCategory {
  equipment
  furniture
  decoration
  other
}

enum StorageType {
  fixed_infrastructure
  warehouse_stored
}

enum AssetCondition {
  new
  good
  fair
  refurbishment
}

enum AssetStatus {
  available
  reserved
  unavailable
}

enum ServiceCategory {
  planning
  decoration
  catering
  photography
  videography
  entertainment
  coordination
  other
}

enum ServiceStatus {
  active
  paused
  unavailable
}

enum EventType {
  corporate
  celebration
  private_experience
  popup
  other
}

enum EventStatus {
  draft
  published
  ongoing
  completed
  cancelled
}

enum BookingStatus {
  draft
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}
