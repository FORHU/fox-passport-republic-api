generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////
// ENUMS
//////////////////////////////////////

enum UserRole {
  user
  mayor
  foxxer
  admin
  super_admin
}

enum ListingStatus {
  draft
  pending_review
  action_required
  published
  hidden
  suspended
  archived
  banned
}

enum ListingType {
  venue
  equipment
  catering
  service
  event
}

enum PropertyType {
  hotel
  resort
  hall
  outdoor
  studio
  land
  private_home
  other
}

enum RoomType {
  entire_place
  private_room
  shared_room
}

enum BookingStatus {
  draft
  pending
  confirmed
  cancelled
  completed
}

enum BookingType {
  standard
  foxxer_service
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PaymentMethod {
  card
  gcash
  paymaya
  bank_transfer
  cash
  other
}

enum CancellationPolicy {
  flexible
  moderate
  strict
  non_refundable
}

enum AttendeeCheckInStatus {
  not_checked_in
  checked_in
}

//////////////////////////////////////
// WEDDING ENUMS
//////////////////////////////////////

enum WeddingCategory {
  wedding_and_commitments
}

enum WeddingVenueSubCategory {
  garden_wedding
  rooftop_wedding
  beach_wedding
  reception_wedding
  church_wedding
}

//////////////////////////////////////
// CELEBRATIONS ENUMS (LOCATION-BASED)
//////////////////////////////////////

enum CelebrationsCategory {
  celebrations
}

enum CelebrationsLocationSubCategory {
  birthday_party
  baby_shower
  bachelor_party
  engagement_party
  graduation_party
  family_reunion
  holiday_party
  house_party
  pool_party
  garden_party
  beach_party
  rooftop_party
}

//////////////////////////////////////
// PRIVATE EXPERIENCE ENUMS
//////////////////////////////////////

enum PrivateExperienceCategory {
  private_experiences
}

enum PrivateExperienceSubCategory {
  private_dining
  private_celebrations
  private_travel_and_retreats
  private_entertainment
  private_learning_and_workshops
  private_wellness_and_lifestyle
  private_adventure
  private_cultural_and_immersive
  private_corporate_and_business
  ultra_private_invite_only
}

//////////////////////////////////////
// POP-UP & SEASONAL EVENT ENUMS (NEW)
//////////////////////////////////////

// 1. Holiday & Festive Pop-Up Events
enum HolidayFestivePopUpCategory {
  holiday_and_festive_popups
}

enum HolidayFestivePopUpSubCategory {
  christmas_popup_market
  new_year_countdown_party
  valentines_popup_dinner
  holy_week_retreat
  easter_family_activities
  halloween_popup_party
  all_saints_all_souls_memorial_event
}

// 2. Festival-Based Seasonal Events
enum FestivalSeasonalEventCategory {
  festival_based_seasonal_events
}

enum FestivalSeasonalEventSubCategory {
  sinulog_themed_popup
  ati_atihan_side_events
  panagbenga_flower_festival_popup
  kadayawan_cultural_event
  pahiyas_art_food_popup
  masskara_night_event
}

// 3. Retail & Lifestyle Pop-Ups
enum RetailLifestylePopUpCategory {
  retail_and_lifestyle_popups
}

enum RetailLifestylePopUpSubCategory {
  local_brand_artisan_market
  fashion_streetwear_popup
  thrift_vintage_market
  beauty_skincare_experience_booth
  home_lifestyle_product_launch
  limited_edition_product_drop
}

//////////////////////////////////////
// MODELS
//////////////////////////////////////

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  username  String   @unique
  role      UserRole @default(user)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings Listing[]
}

model FoxxerProfile {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id])
}

model EventCategory {
  id   String @id @default(uuid())
  name String
  slug String @unique
}

model Listing {
  id          String        @id @default(uuid())
  mayorId     String
  categoryId  String?
  title       String
  description String
  status      ListingStatus @default(draft)
  type        ListingType   @default(venue)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  mayor    User      @relation(fields: [mayorId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
}

model Category {
  id   String @id @default(uuid())
  name String
  slug String @unique
}

model ListingLocation {
  id        String @id @default(uuid())
  listingId String @unique
}

model ListingPricing {
  id        String @id @default(uuid())
  listingId String
}

model ListingAvailability {
  id        String @id @default(uuid())
  listingId String
}

model ListingImage {
  id        String @id @default(uuid())
  listingId String
  url       String
}

model ListingAmenity {
  listingId String
  amenityId String

  @@id([listingId, amenityId])
}

model Review {
  id        String @id @default(uuid())
  listingId String
  userId    String
  rating    Int
}

model Booking {
  id        String        @id @default(uuid())
  listingId String
  userId    String
  status    BookingStatus @default(draft)
}

model Favorite {
  id        String @id @default(uuid())
  userId    String
  listingId String
}
