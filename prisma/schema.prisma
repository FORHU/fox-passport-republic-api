generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// MODELS
model Passport {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  totalStamps  Int      @default(0)
  totalMileage Int      @default(0)
  level        Int      @default(1)
  achievements Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssetImage {
  id          Int     @id @default(autoincrement())
  assetId     Int
  url         String
  altText     String?
  orderIndex  Int?
  isThumbnail Boolean @default(false)
  asset       Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_images")
}

enum RentalStatus {
  pending
  active
  completed
  cancelled
}

model Asset {
  id           Int          @id @default(autoincrement())
  ownerId      Int
  hostId       Int
  categoryId   Int?
  name         String
  description  String
  condition    AssetCondition @default(good) 
  propertyType String?
  roomType     String?
  capacity     Int?
  maxAttendees Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assetImages  AssetImage[]
  category     Category?    @relation(fields: [categoryId], references: [id])
  host         User         @relation("assets_hostIdTousers", fields: [hostId], references: [id])
  owner        User         @relation("assets_ownerIdTousers", fields: [ownerId], references: [id], onDelete: Cascade)
  eventAssets  EventAsset[]
  rentals      AssetRental[]
  deleteAt     DateTime?

  @@map("assets")
}

model BookingAttendee {
  id          Int       @id @default(autoincrement())
  bookingId   Int
  firstName   String
  lastName    String
  email       String?
  phone       String?
  ticketCode  String    @unique
  checkedIn   Boolean   @default(false)
  checkInTime DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_attendees")
}

model Booking {
  id               Int               @id @default(autoincrement())
  eventId          Int
  userId           Int
  guestCount       Int
  totalAmount      Float
  confirmationCode String?           @unique
  stampsEarned     Int               @default(0)
  currentStep      Int?              @default(1)
  status           BookingStatus     @default(pending)
  specialRequests  String?
  start            DateTime          @default(now())
  end              DateTime          @default(now())
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attendees        BookingAttendee[]
  event            Event             @relation(fields: [eventId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  payments         Payment[]

  @@map("bookings")
}

model Category {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String?
  icon             String?
  image            String?
  tagline          String?
  gradient         String?
  spotLabel        String?
  spotColor        String?
  parentCategoryId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("categories")
}

model EventAsset {
  id       Int   @id @default(autoincrement())
  eventId  Int
  assetId  Int
  quantity Int
  asset    Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, assetId])
  @@map("event_assets")
}

model AssetRental {
  id        Int          @id @default(autoincrement())
  assetId   Int
  renterId  Int
  startDate DateTime
  endDate   DateTime
  status    RentalStatus @default(pending)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  renter  User  @relation(fields: [renterId], references: [id])

  @@map("asset_rentals")
}

model EventService {
  id          Int     @id @default(autoincrement())
  eventId     Int
  serviceId   Int
  agreedPrice Float
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([eventId, serviceId])
  @@map("event_services")
}

model Event {
  id            Int            @id @default(autoincrement())
  venueId       Int
  organizerId   Int
  name          String
  description   String
  eventType     EventType
  startDatetime DateTime
  endDatetime   DateTime
  maxAttendees  Int
  totalPrice    Float
  currency      String         @default("PHP")
  status        EventStatus    @default(draft)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bookings      Booking[]
  eventAssets   EventAsset[]
  eventServices EventService[]
  organizer     User           @relation(fields: [organizerId], references: [id])
  venue         Venue          @relation(fields: [venueId], references: [id])

  @@map("events")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  venueId   Int?
  eventId   Int?
  savedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("favorites")
}

model Payment {
  id              Int           @id @default(autoincrement())
  bookingId       Int
  amount          Float
  currency        String
  paymentMethod   String
  paymentStatus   PaymentStatus
  paymentDate     DateTime      @default(now())
  transactionId   String?       @unique
  gatewayResponse String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id                 Int      @id @default(autoincrement())
  venueId            Int?
  eventId            Int?
  userId             Int
  rating             Int
  comment            String?
  isVerifiedAttendee Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model Service {
  id            Int             @id @default(autoincrement())
  ownerId       Int
  name          String
  description   String
  category      ServiceCategory
  price         Float
  status        ServiceStatus   @default(active)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  eventServices EventService[]
  owner         User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("services")
}

model User {
  id                         Int        @id @default(autoincrement())
  email                      String     @unique
  password                   String
  name                       String
  username                   String?    @unique
  profileImage               String?
  phone                      String?
  role                       UserRole   @default(user)
  isVerified                 Boolean    @default(false)
  isHost                     Boolean    @default(false)
  isMayor                    Boolean    @default(false)
  isInvestor                 Boolean    @default(false)
  isFoxer                    Boolean    @default(false)
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
  Passport                   Passport?
  assetsAssetsHostIdTousers  Asset[]    @relation("assets_hostIdTousers")
  assetsAssetsOwnerIdTousers Asset[]    @relation("assets_ownerIdTousers")
  bookings                   Booking[]
  events                     Event[]
  favorites                  Favorite[]
  reviews                    Review[]
  services                   Service[]
  venues                     Venue[]
  rentals                    AssetRental[]

  @@map("users")
}

model VenueImage {
  id          Int     @id @default(autoincrement())
  venueId     Int
  url         String
  altText     String?
  orderIndex  Int?
  isThumbnail Boolean @default(false)
  venue       Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_images")
}

model Venue {
  id          Int          @id @default(autoincrement())
  hostId      Int
  name        String
  description String
  type        VenueType
  capacity    Int
  status      VenueStatus  @default(draft)
  address     String
  city        String
  state       String?
  country     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  events      Event[]
  venueImages VenueImage[]
  host        User         @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@map("venues")
}

// ENUMS

enum UserRole {
  user
  mayor
  investor
  foxer
  admin
}

enum EventStatus {
  draft
  published
  ongoing
  completed
  cancelled
}

enum VenueStatus {
  draft
  pending_review
  published
  suspended
  archived
}

enum BookingStatus {
  draft
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum AssetCategory {
  equipment
  furniture
  decoration
  other
}

enum AssetCondition {
  new
  good
  fair
  refurbished 
}

enum AssetStatus {
  available
  reserved
  unavailable
}

enum EventType {
  corporate
  celebration
  private_experience
  popup
  other
}

enum ServiceCategory {
  planning
  decoration
  catering
  photography
  videography
  entertainment
  coordination
  other
}

enum ServiceStatus {
  active
  paused
  unavailable
}

enum StorageType {
  fixed_infrastructure
  warehouse_stored
}

enum VenueType {
  hotel
  resort
  hall
  garden
  beach
  rooftop
  other
}
