generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// MODELS
model Passport {
  id           String   @id @default(uuid())
  userId       String   @unique
  totalStamps  Int      @default(0)
  totalMileage Int      @default(0)
  level        Int      @default(1)
  achievements Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssetImage {
  id          String  @id @default(uuid())
  assetId     String
  url         String
  altText     String?
  orderIndex  Int?
  isThumbnail Boolean @default(false)
  asset       Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_images")
}

//shared by AssetRental, ServiceRental, and VenueRental
enum RentalStatus {
  pending
  active
  completed
  cancelled
}

model Asset {
  id           String         @id @default(uuid())
  ownerId      String
  hostId       String
  categoryId   String?
  name         String
  description  String
  condition    AssetCondition @default(good)
  propertyType String?
  roomType     String?
  capacity     Int?
  maxAttendees Int?
  price        Float
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  assetStatus  AssetStatus    @default(available)
  billingRate  BillingRate
  assetImages  AssetImage[]
  category     Category?      @relation(fields: [categoryId], references: [id])
  host         User           @relation("assets_hostIdTousers", fields: [hostId], references: [id])
  owner        User           @relation("assets_ownerIdTousers", fields: [ownerId], references: [id], onDelete: Cascade)
  eventAssets  EventAsset[]
  rentals      AssetRental[]
  deleteAt     DateTime?

  @@map("assets")
}

model BookingAttendee {
  id          String    @id @default(uuid())
  bookingId   String
  firstName   String
  lastName    String
  email       String?
  phone       String?
  ticketCode  String    @unique
  checkedIn   Boolean   @default(false)
  checkInTime DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_attendees")
}

model Booking {
  id               String            @id @default(uuid())
  eventId          String
  userId           String
  guestCount       Int
  totalAmount      Float
  confirmationCode String?           @unique
  stampsEarned     Int               @default(0)
  currentStep      Int?              @default(1)
  status           BookingStatus     @default(pending)
  specialRequests  String?
  start            DateTime          @default(now())
  end              DateTime          @default(now())
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attendees        BookingAttendee[]
  event            Event             @relation(fields: [eventId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  payments         Payment[]

  @@map("bookings")
}

model Category {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String?
  icon             String?
  image            String?
  tagline          String?
  gradient         String?
  spotLabel        String?
  spotColor        String?
  parentCategoryId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parentCategory Category?  @relation("CategoryToCategory", fields: [parentCategoryId], references: [id])
  subCategories  Category[] @relation("CategoryToCategory")
  assets         Asset[]

  @@map("categories")
}

model EventAsset {
  id       String @id @default(uuid())
  eventId  String
  assetId  String
  quantity Int
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, assetId])
  @@map("event_assets")
}

model AssetRental {
  id        String       @id @default(uuid())
  assetId   String
  renterId  String
  startDate DateTime
  endDate   DateTime
  status    RentalStatus @default(pending)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  asset  Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  renter User  @relation(fields: [renterId], references: [id])

  @@map("asset_rentals")
}

model EventService {
  id          String  @id @default(uuid())
  eventId     String
  serviceId   String
  agreedPrice Float
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([eventId, serviceId])
  @@map("event_services")
}

model Event {
  id            String         @id @default(uuid())
  venueId       String
  organizerId   String
  name          String
  description   String
  eventType     EventType
  startDatetime DateTime
  endDatetime   DateTime
  maxAttendees  Int
  totalPrice    Float
  currency      String         @default("PHP")
  status        EventStatus    @default(draft)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bookings      Booking[]
  eventAssets   EventAsset[]
  eventServices EventService[]
  organizer     User           @relation(fields: [organizerId], references: [id])
  venue         Venue          @relation(fields: [venueId], references: [id])
  favorites     Favorite[]
  reviews       Review[]

  @@map("events")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  venueId   String?
  eventId   String?
  savedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue?   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("favorites")
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String
  amount          Float
  currency        String
  paymentMethod   String
  paymentStatus   PaymentStatus
  paymentDate     DateTime      @default(now())
  transactionId   String?       @unique
  gatewayResponse String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id                 String   @id @default(uuid())
  venueId            String?
  eventId            String?
  userId             String
  rating             Int
  comment            String?
  isVerifiedAttendee Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue              Venue?   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event              Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Service {
  id            String          @id @default(uuid())
  ownerId       String
  name          String
  description   String
  category      ServiceCategory
  price         Float
  billingRate   BillingRate
  status        ServiceStatus   @default(active)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  eventServices EventService[]
  owner         User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images        ServiceImage[]

  @@map("services")
}

model ServiceImage {
  id          String  @id @default(uuid())
  serviceId   String
  url         String
  altText     String?
  orderIndex  Int?
  isThumbnail Boolean @default(false)
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_images")
}

model ServiceRental {
  id        String       @id @default(uuid())
  serviceId String
  renterId  String
  startDate DateTime
  endDate   DateTime
  status    RentalStatus @default(pending)
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String
  username     String?       @unique
  profileImage String?
  phone        String?
  role         UserRole      @default(user)
  isVerified   Boolean       @default(false)
  isHost       Boolean       @default(false)
  isMayor      Boolean       @default(false)
  isInvestor   Boolean       @default(false)
  isFoxer      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  passport     Passport?
  hostedAssets Asset[]       @relation("assets_hostIdTousers")
  ownedAssets  Asset[]       @relation("assets_ownerIdTousers")
  bookings     Booking[]
  events       Event[]
  favorites    Favorite[]
  reviews      Review[]
  services     Service[]
  venues       Venue[]
  rentals      AssetRental[]

  @@map("users")
}

model VenueImage {
  id          String  @id @default(uuid())
  venueId     String
  url         String
  altText     String?
  orderIndex  Int?
  isThumbnail Boolean @default(false)
  venue       Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_images")
}

model Venue {
  id          String       @id @default(uuid())
  hostId      String
  name        String
  description String
  type        VenueType
  capacity    Int
  status      VenueStatus  @default(draft)
  address     String
  city        String
  state       String?
  country     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  events      Event[]
  venueImages VenueImage[]
  price       Float
  spaceType   String[]
  amenities   String[]
  techAv      String[]
  staffing    String[]
  policies    String[]
  host        User         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  favorites   Favorite[]
  reviews     Review[]

  @@map("venues")
}

model VenueRental {
  id        String       @id @default(uuid())
  venueId   String
  renterId  String
  startDate DateTime
  endDate   DateTime
  status    RentalStatus @default(pending)
}

// ENUMS

enum UserRole {
  user
  mayor
  investor
  foxer
  admin
}

enum EventStatus {
  draft
  published
  ongoing
  completed
  cancelled
}

enum VenueStatus {
  draft
  pending_review
  published
  suspended
  archived
  rejected
}

enum BookingStatus {
  draft
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum AssetCategory {
  equipment
  furniture
  decoration
  other
}

enum AssetCondition {
  new
  good
  fair
  refurbished
}

enum AssetStatus {
  available
  reserved
  unavailable
}

enum EventType {
  corporate
  fair
  birthday
  wedding
  anniversary
  graduation
  other
}

enum ServiceCategory {
  planning
  decoration
  catering
  photography
  videography
  entertainment
  coordination
  other
}

enum ServiceStatus {
  active
  paused
  unavailable
}

//shared by Service and Asset
enum BillingRate {
  hourly
  daily
  weekly
  monthly
  yearly
  one_time
  other
}

enum StorageType {
  fixed_infrastructure
  warehouse_stored
}

enum VenueType {
  hotel
  resort
  hall
  garden
  beach
  rooftop
  other
}
