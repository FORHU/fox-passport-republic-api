generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////
// ENUMS
//////////////////////////////////////

enum UserRole {
  user
  mayor
  host
  foxer
  admin
  super_admin
}

enum ListingStatus {
  draft
  pending_review
  action_required
  published
  hidden
  suspended
  archived
  banned
}

enum ListingType {
  venue
  equipment
  catering
  service
  event
}

enum PropertyType {
  hotel
  resort
  hall
  outdoor
  studio
  land
  private_home
  other
}

enum RoomType {
  entire_place
  private_room
  shared_room
}

enum BookingStatus {
  draft
  pending
  confirmed
  cancelled
  completed
}

enum BookingType {
  standard
  foxer_service
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PaymentMethod {
  card
  gcash
  paymaya
  bank_transfer
  cash
  other
}

enum CancellationPolicy {
  flexible
  moderate
  strict
  non_refundable
}

enum AttendeeCheckInStatus {
  not_checked_in
  checked_in
}

//////////////////////////////////////
// WEDDING ENUMS
//////////////////////////////////////

enum WeddingCategory {
  wedding_and_commitments
}

enum WeddingVenueSubCategory {
  garden_wedding
  rooftop_wedding
  beach_wedding
  reception_wedding
  church_wedding
}

//////////////////////////////////////
// CELEBRATIONS ENUMS (LOCATION-BASED)
//////////////////////////////////////

enum CelebrationsCategory {
  celebrations
}

enum CelebrationsLocationSubCategory {
  birthday_party
  baby_shower
  bachelor_party
  engagement_party
  graduation_party
  family_reunion
  holiday_party
  house_party
  pool_party
  garden_party
  beach_party
  rooftop_party
}

//////////////////////////////////////
// PRIVATE EXPERIENCE ENUMS
//////////////////////////////////////

enum PrivateExperienceCategory {
  private_experiences
}

enum PrivateExperienceSubCategory {
  private_dining
  private_celebrations
  private_travel_and_retreats
  private_entertainment
  private_learning_and_workshops
  private_wellness_and_lifestyle
  private_adventure
  private_cultural_and_immersive
  private_corporate_and_business
  ultra_private_invite_only
}

//////////////////////////////////////
// POP-UP & SEASONAL EVENT ENUMS (NEW)
//////////////////////////////////////

// 1. Holiday & Festive Pop-Up Events
enum HolidayFestivePopUpCategory {
  holiday_and_festive_popups
}

enum HolidayFestivePopUpSubCategory {
  christmas_popup_market
  new_year_countdown_party
  valentines_popup_dinner
  holy_week_retreat
  easter_family_activities
  halloween_popup_party
  all_saints_all_souls_memorial_event
}

// 2. Festival-Based Seasonal Events
enum FestivalSeasonalEventCategory {
  festival_based_seasonal_events
}

enum FestivalSeasonalEventSubCategory {
  sinulog_themed_popup
  ati_atihan_side_events
  panagbenga_flower_festival_popup
  kadayawan_cultural_event
  pahiyas_art_food_popup
  masskara_night_event
}

// 3. Retail & Lifestyle Pop-Ups
enum RetailLifestylePopUpCategory {
  retail_and_lifestyle_popups
}

enum RetailLifestylePopUpSubCategory {
  local_brand_artisan_market
  fashion_streetwear_popup
  thrift_vintage_market
  beauty_skincare_experience_booth
  home_lifestyle_product_launch
  limited_edition_product_drop
}

//////////////////////////////////////
// MODELS
//////////////////////////////////////

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  username     String   @unique
  phone        String?
  profileImage String?
  isHost       Boolean  @default(false)
  isVerified   Boolean  @default(false)
  isFoxer      Boolean  @default(false)
  role         UserRole @default(user)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings     Listing[]
  foxerProfile FoxerProfile?
  bookings     Booking[]
  favorites    Favorite[]
  reviews      Review[]
}

model FoxerProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  bio         String?
  skills      String? // Comma separated string or Json
  isAvailable Boolean @default(true)

  user     User                  @relation(fields: [userId], references: [id])
  services ListingFoxerService[]
}

model EventCategory {
  id   String @id @default(uuid())
  name String
  slug String @unique
}

model Listing {
  id           String        @id @default(uuid())
  hostId       String
  categoryId   String?
  title        String
  description  String
  propertyType String?
  roomType     String?
  status       ListingStatus @default(draft)
  type         ListingType   @default(venue)
  capacity     Int?
  maxAttendees Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  host          User                  @relation(fields: [hostId], references: [id])
  category      Category?             @relation(fields: [categoryId], references: [id])
  foxerServices ListingFoxerService[]
  bookings      Booking[]
  favorites     Favorite[]
  location      ListingLocation?
  pricing       ListingPricing[]
  availability  ListingAvailability[]
  images        ListingImage[]
  amenities     ListingAmenity[]
  reviews       Review[]
}

model Category {
  id               String  @id @default(uuid())
  name             String
  slug             String  @unique
  description      String?
  parentCategoryId String?

  // Design / Presentation
  image     String?
  tagline   String?
  gradient  String? // Tailwind gradient class
  spotLabel String? // "Limited Time", "Exclusive"
  spotColor String? // "text-accent", etc.
  icon      String? // Lucide icon name (e.g. "Gem", "Music")

  listings       Listing[]
  foxerServices  ListingFoxerService[]
  parentCategory Category?             @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subCategories  Category[]            @relation("CategoryHierarchy")
}

model ListingLocation {
  id                 String    @id @default(uuid())
  listingId          String    @unique
  streetAddress      String
  city               String
  state              String?
  country            String
  latitude           Float?
  longitude          Float?
  startDatetime      DateTime?
  endDatetime        DateTime?
  durationMinutes    Int?
  requirements       String?
  cancellationPolicy String?
  itineraryJson      String? // Store as JSON string or Json type

  listing Listing @relation(fields: [listingId], references: [id])
}

model ListingPricing {
  id                String    @id @default(uuid())
  listingId         String
  basePrice         Float
  currency          String    @default("PHP")
  serviceFeePercent Float?
  taxPercent        Float?
  pricingTiers      Json?
  earlyBirdDiscount Json?
  earlyBirdDeadline DateTime?

  listing Listing @relation(fields: [listingId], references: [id])
}

model ListingAvailability {
  id        String  @id @default(uuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
}

model ListingImage {
  id          String  @id @default(uuid())
  listingId   String
  url         String
  altText     String?
  orderIndex  Int?
  isThumbnail Boolean @default(false)

  listing Listing @relation(fields: [listingId], references: [id])
}

model ListingAmenity {
  listingId String
  amenityId String
  listing   Listing @relation(fields: [listingId], references: [id])
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  @@id([listingId, amenityId])
}

model Review {
  id                 String   @id @default(uuid())
  listingId          String
  userId             String
  rating             Int
  comment            String?
  isVerifiedAttendee Boolean  @default(false)
  createdAt          DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model Booking {
  id               String        @id @default(uuid())
  listingId        String
  userId           String
  status           BookingStatus @default(draft)
  type             BookingType   @default(standard)
  confirmationCode String        @unique
  guestCount       Int?
  totalAmount      Float?
  specialRequests  String?
  currentStep      Int           @default(1)
  expiresAt        DateTime?
  foxerServiceId   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user         User                 @relation(fields: [userId], references: [id])
  listing      Listing              @relation(fields: [listingId], references: [id])
  foxerService ListingFoxerService? @relation(fields: [foxerServiceId], references: [id])
  attendees    BookingAttendee[]
  payments     Payment[]
}

model ListingFoxerService {
  id                 String   @id @default(uuid())
  foxerId            String
  listingId          String
  categoryId         String
  serviceName        String
  serviceDescription String?
  price              Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  foxer    FoxerProfile @relation(fields: [foxerId], references: [id])
  listing  Listing      @relation(fields: [listingId], references: [id])
  category Category     @relation(fields: [categoryId], references: [id])
  bookings Booking[]
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  savedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])
}

model BookingAttendee {
  id          String    @id @default(uuid())
  bookingId   String
  firstName   String
  lastName    String
  email       String
  phone       String
  ticketCode  String    @unique
  checkedIn   Boolean   @default(false)
  checkInTime DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String
  amount          Float
  currency        String
  paymentMethod   String
  paymentStatus   PaymentStatus
  paymentDate     DateTime      @default(now())
  transactionId   String?       @unique
  gatewayResponse String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
}

model Amenity {
  id   String  @id @default(uuid())
  name String
  icon String?

  listings ListingAmenity[]
}
