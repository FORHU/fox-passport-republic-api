generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums for better type safety
enum UserRole {
  user
  host
  admin
  super_admin
}

enum EventStatus {
  draft
  active
  cancelled
  completed
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  name         String
  username     String    @unique
  phone        String?
  profileImage String?
  dateOfBirth  DateTime?
  role         UserRole  @default(user)
  isHost       Boolean   @default(false)
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  // Relations
  events    Event[]    @relation("HostEvents")
  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]

  @@index([email])
  @@index([username])
  @@index([role])
}

model Event {
  id           String      @id @default(uuid())
  hostId       String
  categoryId   String?
  title        String
  description  String
  status       EventStatus @default(draft)
  maxAttendees Int?
  isPublished  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  host         User                @relation("HostEvents", fields: [hostId], references: [id], onDelete: Cascade)
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  details      EventDetails?
  pricing      EventPricing[]
  availability EventAvailability[]
  images       EventImage[]
  reviews      Review[]
  bookings     Booking[]
  favorites    Favorite[]

  @@index([hostId])
  @@index([categoryId])
  @@index([status])
  @@index([isPublished])
  @@index([createdAt])
}

model EventDetails {
  id                 String   @id @default(uuid())
  eventId            String   @unique
  locationAddress    String
  city               String
  state              String
  country            String
  latitude           Decimal?
  longitude          Decimal?
  startDatetime      DateTime
  endDatetime        DateTime
  durationMinutes    Int?
  requirements       String?
  cancellationPolicy String?
  itineraryJson      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([startDatetime])
  @@index([city])
  @@index([country])
}

model EventPricing {
  id                String    @id @default(uuid())
  eventId           String
  basePrice         Decimal
  currency          String
  serviceFeePercent Decimal
  taxPercent        Decimal
  pricingTiers      Json?
  earlyBirdDiscount Json?
  earlyBirdDeadline DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventAvailability {
  id             String   @id @default(uuid())
  eventId        String
  availableDate  DateTime
  availableSlots Int
  bookedSlots    Int
  isAvailable    Boolean
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([availableDate])
}

model EventImage {
  id           String   @id @default(uuid())
  eventId      String
  imageUrl     String
  altText      String?
  displayOrder Int?
  isPrimary    Boolean  @default(false)
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([isPrimary])
}

model Category {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String?
  icon             String?
  parentCategoryId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  parentCategory Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subCategories  Category[] @relation("CategoryHierarchy")
  events         Event[]

  @@index([slug])
  @@index([parentCategoryId])
}

model Booking {
  id               String        @id @default(uuid())
  eventId          String
  userId           String
  numberOfTickets  Int
  totalAmount      Decimal
  bookingStatus    BookingStatus @default(pending)
  confirmationCode String        @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  specialRequests  String?

  // Relations
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  attendees BookingAttendee[]
  payments  Payment[]

  @@index([userId])
  @@index([eventId])
  @@index([bookingStatus])
  @@index([confirmationCode])
  @@index([createdAt])
}

model BookingAttendee {
  id          String    @id @default(uuid())
  bookingId   String
  firstName   String
  lastName    String
  email       String
  phone       String
  ticketCode  String    @unique
  checkedIn   Boolean   @default(false)
  checkInTime DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([ticketCode])
  @@index([checkedIn])
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String
  amount          Decimal
  currency        String
  paymentMethod   String
  paymentStatus   PaymentStatus @default(pending)
  transactionId   String        @unique
  paymentDate     DateTime      @default(now())
  gatewayResponse String?

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([transactionId])
  @@index([paymentStatus])
}

model Review {
  id                 String   @id @default(uuid())
  eventId            String
  userId             String
  rating             Int
  comment            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  isVerifiedAttendee Boolean  @default(false)

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
  @@index([rating])
}

model Favorite {
  id      String   @id @default(uuid())
  userId  String
  eventId String
  savedAt DateTime @default(now())

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}
