# Docker Environment Configuration
# Copy this to .env when running in Docker, or set these as docker-compose env vars

# Server Configuration
PORT=3002
FRONTEND_URL=http://localhost:3001
NODE_ENV=production

# JWT Configuration (Change in production!)
SECRET_KEY=docker_secret_key_change_in_production
ACCESS_TOKEN_SECRET=docker_access_secret_change_in_production
REFRESH_TOKEN_SECRET=docker_refresh_secret_change_in_production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Database Configuration (matches docker-compose.yml)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres_password@postgres:5432/fox_passport_db

# Redis Configuration (matches docker-compose.yml)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_TTL_SECONDS=3600

# Supabase Configuration (get from your project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Configuration (Optional - for Nodemailer)
MAILER_TRANSPORT_HOST=smtp.ethereal.email
MAILER_TRANSPORT_PORT=587
MAILER_TRANSPORT_SECURE=false
MAILER_EMAIL=test@example.com
MAILER_PASSWORD=password

# Stripe Payment / Connect
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET
PLATFORM_FEE_PERCENT=5
STRIPE_CONNECT_REFRESH_URL=https://your-frontend-domain/dashboard/payouts/refresh
STRIPE_CONNECT_RETURN_URL=https://your-frontend-domain/dashboard/payouts/return
